function resolveStorageRoot() {
  if (process.env.NOTE_DATA_DIR) {
    return path.resolve(process.env.NOTE_DATA_DIR);
  }

  if (process.platform === 'win32') {
    const base =
      process.env.LOCALAPPDATA ||
      process.env.APPDATA ||
      os.homedir();

    return path.join(base, 'Note');
  }

  if (process.platform === 'darwin') {
    return path.join(
      os.homedir(),
      'Library',
      'Application Support',
      'Note'
    );
  }

  const xdg =
    process.env.XDG_DATA_HOME ||
    path.join(os.homedir(), '.local', 'share');

  return path.join(xdg, 'note');
}

const STORAGE_ROOT = resolveStorageRoot();
const DATA_DIR = path.join(STORAGE_ROOT, 'data');
const UPLOAD_DIR = path.join(STORAGE_ROOT, 'uploads');
const BACKUP_DIR = path.join(STORAGE_ROOT, 'backups');
const DB_FILE = path.join(DATA_DIR, 'notes.json');
const FOLDERS_FILE = path.join(DATA_DIR, 'folders.json');
const FOLDERS_PREVIOUS_FILE = `${FOLDERS_FILE}.previous`;
const LOCK_SESSION_TTL_MS = 30 * 60 * 1000;
const LOCK_SCRYPT_N = 1 << 15;
const LOCK_SCRYPT_R = 8;
const LOCK_SCRYPT_P = 1;


const PORT = Number(process.env.NOTE_PORT || process.env.PORT || 3030);
const HOST = process.env.HOST || '127.0.0.1';
const SHUFANG_SERVER_STATE_FILE = path.join(os.homedir(), '.shufang', 'server.json');

fs.mkdirSync(DATA_DIR, { recursive: true });
fs.mkdirSync(UPLOAD_DIR, { recursive: true });
fs.mkdirSync(BACKUP_DIR, { recursive: true });

function readJsonArray(file) {
  try {
    if (!fs.existsSync(file)) return null;

    const parsed = JSON.parse(
      fs.readFileSync(file, 'utf8') || '[]'
    );

    return Array.isArray(parsed) ? parsed : null;
  } catch {
    return null;
  }
}

function noteFingerprint(note) {
  const identity = note?.locked
    ? {
        locked: true,
        id: String(note?.id || ''),
        ciphertext: String(note?.encryption?.ciphertext || '')
      }
    : {
        title: String(note?.title || ''),
        type: String(note?.type || ''),
        content: String(note?.content || ''),
        folderId: String(note?.folderId || '')
      };

  return crypto
    .createHash('sha1')
    .update(JSON.stringify(identity))
    .digest('hex');
}

const QUARANTINE_DIR = path.join(STORAGE_ROOT, 'quarantine');
const CLEANUP_MARKER_FILE = path.join(STORAGE_ROOT, '.cleanup-v1.2.json');
const DB_PREVIOUS_FILE = `${DB_FILE}.previous`;
const RECOVERY_REPORT_FILE = path.join(STORAGE_ROOT, 'recovery-report.json');

fs.mkdirSync(QUARANTINE_DIR, { recursive: true });

function timestampForFile() {
  return new Date().toISOString().replace(/[:.]/g, '-');
}

function compareUpdatedAt(a, b) {
  return String(a?.updatedAt || '').localeCompare(String(b?.updatedAt || ''));
}

function isRecoveryCopy(note) {
  const title = String(note?.title || '').trim();
  return /(?:（|\()\s*恢复副本\s*(?:）|\))\s*$/u.test(title);
}

function sanitizeNotes(list) {
  const source = Array.isArray(list) ? list : [];
  const stats = {
    input: source.length,
    invalid: 0,
    recoveryCopies: 0,
    duplicateIds: 0,
    exactDuplicates: 0
  };

  // IDs are authoritative for one logical note. If polluted data contains the
  // same ID more than once, retain the most recently updated version only.
  const byId = new Map();
  const withoutRecoveryCopies = [];

  for (const note of source) {
    if (!note || typeof note !== 'object' || Array.isArray(note)) {
      stats.invalid += 1;
      continue;
    }

    if (isRecoveryCopy(note)) {
      stats.recoveryCopies += 1;
      continue;
    }

    const id = typeof note.id === 'string' ? note.id.trim() : '';

    if (!id) {
      withoutRecoveryCopies.push(note);
      continue;
    }

    const existing = byId.get(id);

    if (!existing) {
      byId.set(id, note);
      continue;
    }

    stats.duplicateIds += 1;

    if (compareUpdatedAt(note, existing) > 0) {
      byId.set(id, note);
    }
  }

  withoutRecoveryCopies.push(...byId.values());

  // Remove only byte-for-byte logical duplicates (same title/type/content).
  // We intentionally do NOT deduplicate merely-similar notes.
  const byFingerprint = new Map();

  for (const note of withoutRecoveryCopies) {
    const fp = noteFingerprint(note);
    const existing = byFingerprint.get(fp);

    if (!existing) {
      byFingerprint.set(fp, note);
      continue;
    }

    stats.exactDuplicates += 1;

    if (compareUpdatedAt(note, existing) > 0) {
      byFingerprint.set(fp, note);
    }
  }

  const notes = [...byFingerprint.values()];

  stats.output = notes.length;
  stats.removed = stats.input - stats.output;

  return { notes, stats };
}

function writeDbDirect(notes) {
  const payload = JSON.stringify(notes, null, 2);
  const tmp = `${DB_FILE}.tmp-init-${process.pid}-${Date.now()}`;

  fs.writeFileSync(tmp, payload, 'utf8');

  try {
    if (fs.existsSync(DB_FILE)) {
      fs.unlinkSync(DB_FILE);
    }
    fs.renameSync(tmp, DB_FILE);
  } catch (error) {
    try {
      if (fs.existsSync(tmp)) fs.unlinkSync(tmp);
    } catch {}
    throw error;
  }
}

function quarantineFile(file, targetDir, preferredName = null) {
  if (!fs.existsSync(file)) return null;

  fs.mkdirSync(targetDir, { recursive: true });

  const base = preferredName || path.basename(file);
  let target = path.join(targetDir, base);
  let i = 1;

  while (fs.existsSync(target)) {
    const ext = path.extname(base);
    const stem = ext ? base.slice(0, -ext.length) : base;
    target = path.join(targetDir, `${stem}-${i}${ext}`);
    i += 1;
  }

  try {
    fs.renameSync(file, target);
  } catch {
    fs.copyFileSync(file, target);
    fs.unlinkSync(file);
  }

  return target;
}

function quarantineLegacyRecoveryState(cleanupDir) {
  const moved = [];

  if (fs.existsSync(BACKUP_DIR)) {
    const backupTarget = path.join(cleanupDir, 'legacy-backups');

    for (const name of fs.readdirSync(BACKUP_DIR)) {
      const file = path.join(BACKUP_DIR, name);
      let stat;

      try {
        stat = fs.statSync(file);
      } catch {
        continue;
      }

      if (!stat.isFile()) continue;
      const target = quarantineFile(file, backupTarget);
      if (target) moved.push(target);
    }
  }

  if (fs.existsSync(RECOVERY_REPORT_FILE)) {
    const target = quarantineFile(
      RECOVERY_REPORT_FILE,
      cleanupDir,
      'legacy-recovery-report.json'
    );
    if (target) moved.push(target);
  }

  return moved;
}

function restoreInterruptedWriteIfNeeded() {
  const current = readJsonArray(DB_FILE);

  if (Array.isArray(current)) {
    // A leftover previous file only means a prior write completed but cleanup
    // was interrupted. The canonical DB wins.
    if (fs.existsSync(DB_PREVIOUS_FILE)) {
      try { fs.unlinkSync(DB_PREVIOUS_FILE); } catch {}
    }
    return current;
  }

  const previous = readJsonArray(DB_PREVIOUS_FILE);

  if (Array.isArray(previous)) {
    const stamp = timestampForFile();

    if (fs.existsSync(DB_FILE)) {
      try {
        quarantineFile(
          DB_FILE,
          QUARANTINE_DIR,
          `corrupt-notes-${stamp}.json`
        );
      } catch {}
    }

    fs.renameSync(DB_PREVIOUS_FILE, DB_FILE);
    return previous;
  }

  return null;
}

function runOneTimeCleanup(current) {
  if (fs.existsSync(CLEANUP_MARKER_FILE)) {
    return current;
  }

  const stamp = timestampForFile();
  const cleanupDir = path.join(QUARANTINE_DIR, `cleanup-v1.2-${stamp}`);
  fs.mkdirSync(cleanupDir, { recursive: true });

  // Preserve the exact pre-cleanup DB outside every active recovery path.
  if (fs.existsSync(DB_FILE)) {
    fs.copyFileSync(DB_FILE, path.join(cleanupDir, 'notes-before-cleanup.json'));
  }

  const movedLegacyFiles = quarantineLegacyRecoveryState(cleanupDir);
  const cleaned = sanitizeNotes(current);

  if (cleaned.stats.removed > 0 || !fs.existsSync(DB_FILE)) {
    writeDbDirect(cleaned.notes);
  }

  const report = {
    time: new Date().toISOString(),
    mode: 'v1.2-active-data-cleanup',
    stats: cleaned.stats,
    quarantinedLegacyFiles: movedLegacyFiles,
    quarantineDir: cleanupDir,
    note: 'Quarantine is never scanned or auto-restored by the application.'
  };

  fs.writeFileSync(
    path.join(cleanupDir, 'cleanup-report.json'),
    JSON.stringify(report, null, 2),
    'utf8'
  );

  fs.writeFileSync(
    CLEANUP_MARKER_FILE,
    JSON.stringify(report, null, 2),
    'utf8'
  );

  if (cleaned.stats.removed > 0 || movedLegacyFiles.length > 0) {
    console.log(
      `  数据清理：移除 ${cleaned.stats.removed} 条脏笔记，隔离 ${movedLegacyFiles.length} 个旧恢复文件。`
    );
  }

  return cleaned.notes;
}

function initializeStorage() {
  let current = restoreInterruptedWriteIfNeeded();

  if (!Array.isArray(current)) {
    const stamp = timestampForFile();

    // Do NOT scan backups, adjacent folders or old recovery reports here.
    // A missing/corrupt DB is never a signal to merge historical snapshots.
    if (fs.existsSync(DB_FILE)) {
      try {
        quarantineFile(
          DB_FILE,
          QUARANTINE_DIR,
          `unreadable-notes-${stamp}.json`
        );
      } catch {}
    }

    current = [];
    writeDbDirect(current);
  }

  current = runOneTimeCleanup(current);

  // Self-heal on every startup. This is deliberately narrow: only the exact
  // artifacts produced by the old recovery bug plus exact duplicates / ID
  // collisions are removed. It never merges any historical source.
  const cleaned = sanitizeNotes(current);

  if (cleaned.stats.removed > 0) {
    const stamp = timestampForFile();
    const dir = path.join(QUARANTINE_DIR, `startup-sanitize-${stamp}`);
    fs.mkdirSync(dir, { recursive: true });

    if (fs.existsSync(DB_FILE)) {
      fs.copyFileSync(DB_FILE, path.join(dir, 'notes-before-sanitize.json'));
    }

    writeDbDirect(cleaned.notes);

    fs.writeFileSync(
      path.join(dir, 'sanitize-report.json'),
      JSON.stringify({
        time: new Date().toISOString(),
        stats: cleaned.stats
      }, null, 2),
      'utf8'
    );

    console.log(`  启动校验：清理 ${cleaned.stats.removed} 条异常记录。`);
  }
}

initializeStorage();
if (!fs.existsSync(FOLDERS_FILE) && fs.existsSync(FOLDERS_PREVIOUS_FILE)) {
  try { fs.renameSync(FOLDERS_PREVIOUS_FILE, FOLDERS_FILE); } catch {}
}
if (!fs.existsSync(FOLDERS_FILE)) writeFolders([]);

function repairOrphanFolderIds() {
  const valid = new Set(readFolders().map(folder => folder.id));
  const notes = readNotes();
  let changed = false;
  for (const note of notes) {
    if (note.folderId && !valid.has(note.folderId)) {
      note.folderId = null;
      changed = true;
    }
  }
  if (changed) {
    writeNotes(notes);
    console.log('  目录校验：已将失效目录中的笔记移回根目录。');
  }
}

repairOrphanFolderIds();

