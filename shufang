}

async function validateDirectory(dir, label) {
  if (!dir) throw new Error(`${label}不能为空。`);
  const full = normalizePath(dir);
  const st = await fsp.stat(full).catch(() => null);
  if (!st?.isDirectory()) throw new Error(`${label}不是有效目录：${full}`);
  return full;
}

async function main() {
  const args = process.argv.slice(2);
  if (!args.length || args.includes('-h') || args.includes('--help') || args.includes('帮助')) {
    printUsage();
    return;
  }

  console.log('\n📚 书房 v0.7.0');
  const db = openDatabase();
  const rootA = await validateDirectory(args[0], '目录');
  const updateIndex = args.indexOf('更新');

  if (updateIndex >= 0) {
    const rootB = await validateDirectory(args[updateIndex + 1], '目录B');
    const result = await updateLibrary(db, rootA, rootB);
    if (result.updateDir) console.log(`📁 新增文件目录：${result.updateDir}`);
    db.close();
    return;
  }

  const online = args.includes('联网') || args.includes('--online');
  const result = await scanLibrary(db, rootA, { online, stageTotal: 3 });
  console.log('  [3/3] 正在启动 Web App…');
  const port = Number(process.env.SHUFANG_PORT || DEFAULT_PORT);
  await startServer(db, rootA, result.library.id, port);
  console.log('  [3/3] ✓ Web App 已就绪');
  const url = SHUFANG_PUBLIC_ORIGIN || `http://127.0.0.1:${port}`;
  console.log(`\n✅ 书房准备完成：${result.unique} 本唯一书籍`);
  console.log(`🌐 Web App 已启动：${url}`);
  console.log(`   ${process.env.SHUFANG_NO_OPEN === '1' ? '由统一启动器管理浏览器；' : '浏览器将自动打开；'}封面将在后台低速维护；按 Ctrl+C 关闭书房。\n`);
  if (process.env.SHUFANG_NO_OPEN !== '1') openBrowser(url);
  startBackgroundCoverMaintenance(db, result.library.id);
}

main().catch(error => {
  console.error(`\n❌ ${error.message}\n`);
  process.exitCode = 1;
});
