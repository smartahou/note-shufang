async function renderPdfCover(canvas,book){
  const box=canvas.parentElement;
  try{
    const pdfjs=await getPdfJs();
    const task=pdfjs.getDocument({url:'/book/'+encodeURIComponent(book.hash),rangeChunkSize:131072,disableAutoFetch:false,disableStream:false});
    const pdf=await task.promise;
