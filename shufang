  `);

  let total = 0;
  let reused = 0;
  let relocated = 0;
  let hashed = 0;
  let failed = 0;
  const started = Date.now();

  if (!silent) {
    console.log(`\n📚 ${label}：${root}`);
    console.log(`   缓存：${DB_PATH}`);
    if (online) console.log('   联网：已开启（仅用于低置信度书目补全）');
  }

  const bookFiles = await collectBookFiles(root, { silent, stageTotal });
  total = bookFiles.length;
  const progress = new TerminalProgress(total, { label, quiet: silent });
  if (!silent) console.log(`  [2/${stageTotal}] 校验缓存、文件指纹与书籍元数据`);

  for (let index = 0; index < bookFiles.length; index++) {
    const filePath = bookFiles[index];
    const relative = path.relative(root, filePath);
    try {
      progress.update({ done: index, reused, hashed, failed, status: '读取文件', detail: '', file: relative });
      const stat = await statBookFile(filePath);
      const cached = cachedStmt.get(library.id, relative);
      let hash;
      let meta;
      let reuseKind = '';

      const exactIdentityOkay = !cached || !cached.file_dev || !cached.file_ino || !stat.fileDev || !stat.fileIno
        || (String(cached.file_dev) === stat.fileDev && String(cached.file_ino) === stat.fileIno);
      if (cached && Number(cached.size) === stat.size && sameMtime(cached.mtime_ms, stat.mtimeMs) && exactIdentityOkay) {
        hash = cached.hash;
        reused++;
        reuseKind = 'exact';
      } else if (stat.fileDev && stat.fileIno && stat.fileIno !== '0') {
        const movedCandidates = relocatedStmt.all(library.id, stat.fileDev, stat.fileIno, stat.size)
          .filter(x => sameMtime(x.mtime_ms, stat.mtimeMs));
        const movedHashes = [...new Set(movedCandidates.map(x => x.hash).filter(Boolean))];
        if (movedHashes.length === 1) {
          hash = movedHashes[0];
          reused++;
          relocated++;
          reuseKind = 'relocated';
        }
      }

      if (hash) {
        const oldMeta = fileMetaStmt.get(hash);
        if (cachedMetadataNeedsRepair(filePath, oldMeta)) {
          progress.update({ reused, relocated, status: '校正异常元数据', detail: '', file: relative });
          meta = await detectMetadata(filePath, stat, { online });
          upsertFile(db, hash, stat.size, path.extname(filePath).toLowerCase(), meta, { force: true });
        } else {
          if (oldMeta && Number(oldMeta.metadata_version || 0) < METADATA_VERSION) {
            db.prepare('UPDATE files SET metadata_version=? WHERE hash=?').run(METADATA_VERSION, hash);
          }
          progress.update({ reused, relocated, status: reuseKind === 'relocated' ? '移动复用' : '缓存命中', detail: '', file: relative });
        }
      } else {
        progress.update({ relocated, status: '计算 SHA-256', detail: '0%', file: relative });
        hash = await sha256(filePath, {
          totalBytes: stat.size,
          onProgress: (readBytes, totalBytes) => {
            const pct = totalBytes ? Math.min(100, Math.floor(readBytes / totalBytes * 100)) : 0;
            progress.update({ status: '计算 SHA-256', detail: `${pct}%`, file: relative });
          }
        });
        hashed++;
        progress.update({ hashed, relocated, status: '识别元数据', detail: '', file: relative });
        meta = await detectMetadata(filePath, stat, { online });
        upsertFile(db, hash, stat.size, path.extname(filePath).toLowerCase(), meta);
      }

      // 如果 hash 是通过缓存复用，但 files 记录意外不存在，则补建。
      const exists = db.prepare('SELECT 1 AS ok FROM files WHERE hash=?').get(hash);
      if (!exists) {
        progress.update({ status: '补建元数据', detail: '', file: relative });
        meta = meta || await detectMetadata(filePath, stat, { online });
        upsertFile(db, hash, stat.size, path.extname(filePath).toLowerCase(), meta);
      }

      upsertLocalProfile(db, library.id, hash, relative, filePath);
      upsertLocStmt.run(library.id, hash, relative, filePath, stat.size, stat.mtimeMs, stat.fileDev, stat.fileIno, scanId);
      progress.update({ done: index + 1, reused, relocated, hashed, failed, status: '扫描', detail: '', file: relative });
    } catch (error) {
      failed++;
      progress.clear();
      if (!silent) console.warn(`\n⚠ 跳过：${relative} (${error.message})`);
      progress.update({ done: index + 1, reused, hashed, failed, status: '继续扫描', detail: '', file: relative });
    }
  }

  progress.finish();

  if (!silent) console.log(`  [2/${stageTotal}] 正在整理索引…`);
  // 删除这个书库中本次已不存在的路径。
  db.prepare('DELETE FROM locations WHERE library_id = ? AND last_seen_scan <> ?').run(library.id, scanId);
  rebuildDirectoryRolesAndLocalAuthors(db, library.id);
  db.prepare('UPDATE libraries SET scanned_at = ? WHERE id = ?').run(scanId, library.id);

  const unique = db.prepare('SELECT COUNT(DISTINCT hash) AS n FROM locations WHERE library_id=?').get(library.id).n;
  const duplicateLocations = Math.max(0, total - Number(unique));
  const seconds = ((Date.now() - started) / 1000).toFixed(1);
  if (!silent) {
    console.log(`  [2/${stageTotal}] ✓ 索引整理完成`);
    console.log(`\n✅ 文件索引完成`);
    console.log(`   文件位置：${total}   唯一内容：${unique}   重复副本：${duplicateLocations}`);
    console.log(`   缓存命中：${reused}   其中路径变化复用：${relocated}   重新计算指纹：${hashed}   失败：${failed}`);
    console.log(`   用时：${seconds}s`);
  }

  return { library, total, unique, reused, relocated, hashed, failed, duplicateLocations };
}

function getHashSetForLibrary(db, libraryId) {
  const rows = db.prepare('SELECT DISTINCT hash FROM locations WHERE library_id=?').all(libraryId);
  return new Set(rows.map(r => r.hash));
}

function getOneLocationPerHash(db, libraryId) {
  const rows = db.prepare(`
    SELECT l.hash, MIN(l.relative_path) AS relative_path, MIN(l.absolute_path) AS absolute_path,
           f.title, f.author, f.ext, f.size
    FROM locations l
    JOIN files f ON f.hash=l.hash
    WHERE l.library_id=?
    GROUP BY l.hash
  `).all(libraryId);
  return new Map(rows.map(r => [r.hash, r]));
}

async function copyWithParents(src, dst) {
  await ensureDir(path.dirname(dst));
  await fsp.copyFile(src, dst, fs.constants.COPYFILE_EXCL);
}

async function updateLibrary(db, targetRoot, sourceRoot) {
  targetRoot = normalizePath(targetRoot);
  sourceRoot = normalizePath(sourceRoot);
  if (targetRoot === sourceRoot) throw new Error('目录A和目录B不能是同一个目录。');

  console.log('\n🔄 书房 · 差异更新');
  console.log('   判重规则：SHA-256（只认文件内容，不认文件名和目录）');
  console.log(`   目录 A：${targetRoot}`);
  console.log(`   目录 B：${sourceRoot}`);

  const a = await scanLibrary(db, targetRoot, { silent: false, label: '扫描目录 A' });
  const b = await scanLibrary(db, sourceRoot, { silent: false, label: '扫描目录 B' });

  console.log('\n🧮 正在比较 A 与 B 的唯一文件指纹…');
  const aHashes = getHashSetForLibrary(db, a.library.id);
  const bFiles = getOneLocationPerHash(db, b.library.id);
  const missing = [...bFiles.entries()].filter(([hash]) => !aHashes.has(hash));

  if (!missing.length) {
    console.log('✅ 比较完成：A 已包含 B 中的所有唯一文件，没有需要更新的书。');
    return { copied: 0, updateDir: null };
  }

  const updateDir = path.join(targetRoot, `更新_${nowStamp()}`);
  await ensureDir(updateDir);
  const manifest = {
    mode: 'B_MINUS_A',
    targetDirectoryA: targetRoot,
    sourceDirectoryB: sourceRoot,
    createdAt: new Date().toISOString(),
    compareBy: 'SHA-256',
    totalMissing: missing.length,
    books: [],
  };

  let copied = 0;
  let failed = 0;
  console.log(`✅ 比较完成：发现 ${missing.length} 个 B 有而 A 没有的唯一文件`);
  console.log(`📦 正在复制到：${updateDir}`);
  const copyProgress = new CopyProgress(missing.length);

  for (const [hash, item] of missing) {
    const src = item.absolute_path;
    const safeRelative = item.relative_path.replace(/^[\\/]+/, '');
    let dst = path.join(updateDir, safeRelative);
    copyProgress.file = item.relative_path;
    copyProgress.update();

    // 理论上新时间目录不会冲突；这里仍然防御同相对路径异常。
    if (fs.existsSync(dst)) {
      const ext = path.extname(dst);
      const stem = path.basename(dst, ext);
      dst = path.join(path.dirname(dst), `${stem}__${hash.slice(0, 8)}${ext}`);
    }

    try {
      await copyWithParents(src, dst);
      copied++;
      manifest.books.push({
        sha256: hash,
        title: item.title || '',
        author: item.author || '',
        sourceRelativePath: item.relative_path,
        copiedRelativePath: path.relative(updateDir, dst),
        size: item.size,
      });
    } catch (error) {
      failed++;
      if (copyProgress.dynamic) process.stdout.write('\r\x1b[2K');
      console.warn(`⚠ 复制失败：${item.relative_path} (${error.message})`);
    }
    copyProgress.done = copied + failed;
    copyProgress.failed = failed;
    copyProgress.file = item.relative_path;
    copyProgress.update();
  }

  copyProgress.finish();
  await fsp.writeFile(
    path.join(updateDir, '更新清单.json'),
    JSON.stringify({ ...manifest, copied, failed }, null, 2),
    'utf8'
  );
  console.log(`✅ 更新完成：成功 ${copied}，失败 ${failed}`);

  // 增量重扫 A，新复制文件立即进入缓存。
  console.log('🔁 正在把新增文件写回书房索引…');
  await scanLibrary(db, targetRoot, { silent: true });
  return { copied, failed, updateDir };
}


let coverJobs = new Map();

function coverCacheBase(hash) {
  return path.join(COVERS_DIR, `${hash}.v${COVER_VERSION}`);
}

function coverMimeFromExt(ext) {
  return {
    '.png': 'image/png',
    '.jpg': 'image/jpeg',
    '.jpeg': 'image/jpeg',
    '.webp': 'image/webp',
    '.gif': 'image/gif',
    '.svg': 'image/svg+xml; charset=utf-8',
  }[String(ext || '').toLowerCase()] || 'application/octet-stream';
}

function findCachedCover(hash) {
  const base = coverCacheBase(hash);
  for (const ext of ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.svg']) {
    const filePath = base + ext;
    if (fs.existsSync(filePath)) return { path: filePath, mime: coverMimeFromExt(ext) };
  }
  return null;
}

function sniffImageBuffer(buffer) {
  if (!buffer || buffer.length < 8) return null;
  if (buffer[0] === 0x89 && buffer.subarray(1, 4).toString('ascii') === 'PNG') return { ext: '.png', mime: 'image/png' };
  if (buffer[0] === 0xff && buffer[1] === 0xd8) return { ext: '.jpg', mime: 'image/jpeg' };
  if (buffer.subarray(0, 6).toString('ascii') === 'GIF87a' || buffer.subarray(0, 6).toString('ascii') === 'GIF89a') return { ext: '.gif', mime: 'image/gif' };
  if (buffer.subarray(0, 4).toString('ascii') === 'RIFF' && buffer.subarray(8, 12).toString('ascii') === 'WEBP') return { ext: '.webp', mime: 'image/webp' };
  const head = buffer.subarray(0, Math.min(buffer.length, 512)).toString('utf8').trimStart();
  if (/^<\?xml\b|^<svg\b/i.test(head) && /<svg\b/i.test(head)) return { ext: '.svg', mime: 'image/svg+xml; charset=utf-8' };
  return null;
}

function xmlEscape(s) {
  return String(s ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&apos;');
}

function wrapTextSimple(text, maxChars = 13, maxLines = 7) {
  const chars = [...cleanText(text)];
  const lines = [];
  let line = '';
  let width = 0;
  for (const ch of chars) {
    const w = charDisplayWidth(ch);
    if (line && width + w > maxChars * 2) {
      lines.push(line);
      if (lines.length >= maxLines) break;
      line = ch;
      width = w;
    } else {
      line += ch;
      width += w;
    }
  }
  if (line && lines.length < maxLines) lines.push(line);
  return lines;
}

function makeSvgFallbackCover(item) {
  const title = cleanText(item.title || path.basename(item.absolute_path || '', path.extname(item.absolute_path || ''))) || '未命名书籍';
  const author = cleanText(item.author || '');
  const ext = String(item.ext || path.extname(item.absolute_path || '') || '').replace('.', '').toUpperCase() || 'BOOK';
  const lines = wrapTextSimple(title, 12, 7);
  const titleSpans = lines.map((line, i) => `<tspan x="32" dy="${i === 0 ? 0 : 42}">${xmlEscape(line)}</tspan>`).join('');
  return Buffer.from(`<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="360" height="520" viewBox="0 0 360 520">
  <rect width="360" height="520" fill="#eef1f4"/>
  <rect x="0" y="0" width="7" height="520" fill="#d8dde3"/>
  <text x="32" y="86" font-family="Microsoft YaHei, PingFang SC, Noto Sans CJK SC, sans-serif" font-size="28" font-weight="700" fill="#24282d">${titleSpans}</text>
  ${author ? `<text x="32" y="438" font-family="Microsoft YaHei, PingFang SC, sans-serif" font-size="19" fill="#68707a">${xmlEscape(author)}</text>` : ''}
  <text x="32" y="486" font-family="Consolas, monospace" font-size="15" fill="#969da6">${xmlEscape(ext)}</text>
</svg>`, 'utf8');
}

function resolveZipPath(base, rel) {
  const joined = path.posix.normalize(path.posix.join(path.posix.dirname(base), rel || ''));
  return joined.replace(/^\.\//, '');
}

async function extractEpubCoverBuffer(filePath) {
  try {
    const zip = new AdmZip(filePath);
    // 封面识别这里直接去掉 XML namespace 前缀，兼容 opf:package / dc:title 等写法。
    const parser = new XMLParser({
      ignoreAttributes: false,
      attributeNamePrefix: '',
      removeNSPrefix: true,
      parseTagValue: false,
      trimValues: true,
    });
    const containerEntry = zip.getEntry('META-INF/container.xml');
    if (!containerEntry) return null;
    const container = parser.parse(containerEntry.getData().toString('utf8'));
    let rootfile = container?.container?.rootfiles?.rootfile;
    if (Array.isArray(rootfile)) rootfile = rootfile[0];
    const opfPath = rootfile?.['full-path'];
    if (!opfPath) return null;
    const opfEntry = zip.getEntry(opfPath);
    if (!opfEntry) return null;
    const opf = parser.parse(opfEntry.getData().toString('utf8'));
    const pkg = opf?.package;
    if (!pkg) return null;

    const manifestRaw = pkg?.manifest?.item || [];
    const items = Array.isArray(manifestRaw) ? manifestRaw : [manifestRaw].filter(Boolean);
    const byId = new Map(items.filter(Boolean).map(i => [String(i.id || ''), i]));
    const metadata = pkg?.metadata || {};

    const readEntry = href => {
      if (!href) return null;
      const cleanHref = String(href).split('#')[0].split('?')[0];
      const entry = zip.getEntry(resolveZipPath(opfPath, cleanHref));
      return entry ? entry.getData() : null;
    };

    const isImageItem = item => /^image\//i.test(String(item?.['media-type'] || ''));
    const returnImageItem = item => item && isImageItem(item) && item.href ? readEntry(item.href) : null;

    // EPUB 3 标准：properties="cover-image"
    let coverItem = items.find(i => /(?:^|\s)cover-image(?:\s|$)/i.test(String(i?.properties || '')));
    let buf = returnImageItem(coverItem);
    if (buf) return buf;

    // EPUB 2 常见：<meta name="cover" content="cover-id" />
    let metas = metadata.meta || [];
    metas = Array.isArray(metas) ? metas : [metas].filter(Boolean);
    const coverMeta = metas.find(m => String(m?.name || '').toLowerCase() === 'cover' && m?.content);
    if (coverMeta) {
      coverItem = byId.get(String(coverMeta.content || ''));
      buf = returnImageItem(coverItem);
      if (buf) return buf;
    }

    // 许多旧 EPUB 只有 id/href 中带 cover。
    coverItem = items.find(i => isImageItem(i) && /cover|front/i.test(`${i?.id || ''} ${i?.href || ''}`));
    buf = returnImageItem(coverItem);
    if (buf) return buf;

    // guide 可能指向 cover.xhtml/html，而不是直接图片。
    let refs = pkg?.guide?.reference || [];
    refs = Array.isArray(refs) ? refs : [refs].filter(Boolean);
    const guideCover = refs.find(r => /cover/i.test(String(r?.type || '')) || /cover/i.test(String(r?.title || '')));

    const imageFromHtml = (htmlHref) => {
      if (!htmlHref) return null;
      const cleanHref = String(htmlHref).split('#')[0].split('?')[0];
      const htmlPath = resolveZipPath(opfPath, cleanHref);
      const entry = zip.getEntry(htmlPath);
      if (!entry) return null;
      const html = entry.getData().toString('utf8');
      const m = html.match(/<(?:img|image)\b[^>]*(?:src|href|xlink:href)\s*=\s*["']([^"']+)["']/i);
      if (!m) return null;
      const imagePath = path.posix.normalize(path.posix.join(path.posix.dirname(htmlPath), m[1].split('#')[0].split('?')[0]));
      const imageEntry = zip.getEntry(imagePath.replace(/^\.\//, ''));
      return imageEntry ? imageEntry.getData() : null;
    };

    if (guideCover?.href) {
      const direct = readEntry(guideCover.href);
      const guideItem = items.find(i => String(i?.href || '').split('#')[0] === String(guideCover.href || '').split('#')[0]);
      if (guideItem && isImageItem(guideItem) && direct) return direct;
      buf = imageFromHtml(guideCover.href);
      if (buf) return buf;
    }

    // 没有显式 cover 时，看 spine 第一篇正文；不少电子书的第一页就是封面 XHTML。
    let itemrefs = pkg?.spine?.itemref || [];
    itemrefs = Array.isArray(itemrefs) ? itemrefs : [itemrefs].filter(Boolean);
    for (const ref of itemrefs.slice(0, 3)) {
      const item = byId.get(String(ref?.idref || ''));
      if (!item?.href) continue;
      buf = imageFromHtml(item.href);
      if (buf) return buf;
    }

    // 最后才用“最大图片”兜底；这样即使 EPUB 标记不规范，也大概率能拿到封面。
    const imageCandidates = items
      .filter(i => isImageItem(i) && i?.href)
      .map(i => {
        const entry = zip.getEntry(resolveZipPath(opfPath, String(i.href).split('#')[0].split('?')[0]));
        return entry ? { item: i, entry, size: Number(entry.header?.size || entry.header?.compressedSize || 0) } : null;
      })
      .filter(Boolean)
      .sort((a, b) => b.size - a.size);
    if (imageCandidates[0]?.entry) return imageCandidates[0].entry.getData();

    return null;
  } catch {
    return null;
  }
}


function withTimeout(promise, ms, onTimeout, label = '操作') {
  let timer;
  return Promise.race([
    Promise.resolve(promise).finally(() => clearTimeout(timer)),
    new Promise((_, reject) => {
      timer = setTimeout(() => {
        try { onTimeout?.(); } catch {}
        reject(new Error(`${label}超时（${Math.round(ms / 1000)}s）`));
      }, ms);
      // 这里故意不 unref。主函数 await Promise 并不会让 Node 事件循环保持存活；
      // 如果最后一两个异常 PDF 只剩这个超时器兜底，unref 会导致进程在 99% 左右直接正常退出。
    }),
  ]);
}

async function writeCoverCache(hash, buffer, info) {
  if (!buffer || !info?.ext) return null;
  await ensureDir(COVERS_DIR);
  const target = coverCacheBase(hash) + info.ext;
  const tmp = `${target}.${process.pid}.${Date.now()}.tmp`;
  await fsp.writeFile(tmp, buffer);
  try {
    await fsp.rename(tmp, target);
  } catch {
    await fsp.rm(tmp, { force: true });
  }
  return fs.existsSync(target) ? { path: target, mime: info.mime || coverMimeFromExt(info.ext) } : null;
}

async function appendCoverError(item, error) {
  try {
    await ensureDir(APP_DIR);
    const line = `[${new Date().toISOString()}] ${item?.absolute_path || item?.relative_path || 'unknown'}\n${errorText(error)}\n\n`;
    await fsp.appendFile(COVER_ERROR_LOG, line, 'utf8');
  } catch {
    // 日志写入失败不能影响书库启动。
  }
}

async function ensureCover(item, hash, { quiet = false } = {}) {
  const cached = findCachedCover(hash);
  if (cached) return cached;
  if (coverJobs.has(hash)) return coverJobs.get(hash);

  const job = (async () => {
    try {
      const ext = String(item.ext || path.extname(item.absolute_path || '')).toLowerCase();

      // PDF 封面也通过隔离阅读 worker 渲染。后台封面即使遇到损坏 PDF，
      // 最坏只会结束子进程，不允许影响书房主 Web 服务。
      if (ext === '.pdf') {
        const rendered = await renderPdfReaderPage(item, 1, 500);
        const raw = await fsp.readFile(rendered.path);
        return await writeCoverCache(hash, raw, { ext: '.png', mime: 'image/png' });
      }

      if (ext === '.epub') {
        const raw = await extractEpubCoverBuffer(item.absolute_path);
        const info = sniffImageBuffer(raw);
        if (raw && info) return await writeCoverCache(hash, raw, info);
      }

      // EPUB 本身没有封面、或其他格式：生成纯 SVG 书封，不依赖任何原生 Canvas 模块。
      return await writeCoverCache(hash, makeSvgFallbackCover(item), { ext: '.svg', mime: 'image/svg+xml; charset=utf-8' });
    } catch (error) {
      await appendCoverError(item, error);
      // 默认不逐本刷屏；需要排查时可设置 SHUFANG_VERBOSE=1 查看具体失败项。
      if (!quiet && process.env.SHUFANG_VERBOSE === '1') {
        console.warn(`⚠ 封面生成失败：${path.basename(item.absolute_path || '')} (${error.message})`);
      }
      return null;
    } finally {
      coverJobs.delete(hash);
    }
  })();

  coverJobs.set(hash, job);
  return job;
}

async function generateLibraryCovers(db, libraryId, { silent = false, concurrency = 2, stageTotal = 4, paceMs = 0 } = {}) {
  const items = [...getOneLocationPerHash(db, libraryId).values()];
  const total = items.length;
  let cached = 0;
  let generated = 0;
  let failed = 0;
  let nextIndex = 0;
  let completed = 0;

  if (!silent) {
    console.log(`  [3/${stageTotal}] 生成缺失封面缓存（PDF 首页 / EPUB 原封面）`);
    try { await fsp.writeFile(COVER_ERROR_LOG, '', 'utf8'); } catch {}
  }
  const progress = new CoverProgress(total, { quiet: silent });

  async function worker() {
    while (true) {
      const index = nextIndex++;
      if (index >= total) return;
      const item = items[index];
      const ext = String(item.ext || path.extname(item.absolute_path || '')).toLowerCase();
      const relative = item.relative_path || path.basename(item.absolute_path || '');

      try {
        const existing = findCachedCover(item.hash);
        if (existing) {
          cached++;
          progress.update({
            cached,
            generated,
            failed,
            status: '封面缓存命中',
            file: relative,
          });
          continue;
        }

        progress.update({
          cached,
          generated,
          failed,
          status: ext === '.pdf' ? '渲染 PDF 首页' : ext === '.epub' ? '提取 EPUB 封面' : '生成书籍封面',
          file: relative,
        });

        if (silent) await waitForReaderIdle();
        const cover = await ensureCover(item, item.hash, { quiet: true });
        if (cover) generated++;
        else failed++;
      } catch {
        failed++;
      } finally {
        completed++;
        progress.update({
          done: completed,
          cached,
          generated,
          failed,
          status: '生成封面',
          file: relative,
        });
        if (paceMs > 0) await new Promise(resolve => setTimeout(resolve, paceMs));
      }
    }
  }

  // PDF 页面在独立子进程中渲染；后台维护只保留低并发调度。
  const workers = Math.max(1, Math.min(Number(concurrency) || 1, 2, total || 1));
  await Promise.all(Array.from({ length: workers }, () => worker()));
  progress.finish();

  if (!silent) {
    console.log(`  [3/${stageTotal}] ✓ 封面缓存完成：已有 ${cached}，新生成 ${generated}，失败 ${failed}`);
    if (failed) console.log(`       失败项已跳过，不影响启动；详情记录：${COVER_ERROR_LOG}`);
  }
  return { total, cached, generated, failed, internalPdfErrors: 0 };
}

function startBackgroundCoverMaintenance(db, libraryId) {
  // 封面维护完全脱离启动主链路：Web App 已经可用后，才在后台单线程慢慢检查。
  // 每本之间主动让出时间片，避免扫描版 PDF 封面渲染抢占阅读器/搜索体验。
  setTimeout(() => {
    console.log('🎨 封面缓存已转入后台低速维护，不影响书房使用。');
    generateLibraryCovers(db, libraryId, { silent: true, concurrency: 1, paceMs: 280 })
      .then(r => {
        if (r.generated || r.failed) console.log(`🎨 后台封面维护完成：新增 ${r.generated}${r.failed ? ` · 跳过 ${r.failed}` : ''}`);
      })
      .catch(err => console.warn(`🎨 后台封面维护已停止：${err?.message || err}`));
  }, 6500);
}

async function saveBrowserRenderedPdfCover(hash, buffer) {
  if (!buffer || buffer.length < 100 || buffer.length > 4 * 1024 * 1024) return null;
  // 只接受 PNG，避免把任意内容写进封面缓存。
  const info = sniffImageBuffer(buffer);
  if (!info || info.ext !== '.png') return null;
  return writeCoverCache(hash, buffer, info);
}

function contentType(filePath) {
  const ext = path.extname(filePath).toLowerCase();
  const map = {
    '.pdf': 'application/pdf',
    '.epub': 'application/epub+zip',
    '.txt': 'text/plain; charset=utf-8',
    '.md': 'text/markdown; charset=utf-8',
    '.cbz': 'application/vnd.comicbook+zip',
    '.html': 'text/html; charset=utf-8',
    '.htm': 'text/html; charset=utf-8',
    '.xhtml': 'text/html; charset=utf-8',
    '.css': 'text/css; charset=utf-8',
    '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.png': 'image/png', '.gif': 'image/gif', '.webp': 'image/webp', '.svg': 'image/svg+xml',
    '.woff': 'font/woff', '.woff2': 'font/woff2', '.ttf': 'font/ttf', '.otf': 'font/otf',
  };
  return map[ext] || 'application/octet-stream';
}

