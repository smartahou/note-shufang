function humanSize(bytes) {
  if (!Number.isFinite(bytes)) return '-';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  let n = bytes;
  let i = 0;
  while (n >= 1024 && i < units.length - 1) {
    n /= 1024;
    i++;
  }
  return `${n >= 10 || i === 0 ? n.toFixed(0) : n.toFixed(1)} ${units[i]}`;
}


function terminalWidth() {
  const cols = Number(process.stdout.columns || 0);
  return Number.isFinite(cols) && cols >= 40 ? cols : 100;
}

function charDisplayWidth(ch) {
  const cp = ch.codePointAt(0);
  // 常见 CJK / 全角字符 / emoji 在 Windows Terminal 中基本占 2 列。
  if (
    cp >= 0x1100 && (
      cp <= 0x115f || cp === 0x2329 || cp === 0x232a ||
      (cp >= 0x2e80 && cp <= 0xa4cf && cp !== 0x303f) ||
      (cp >= 0xac00 && cp <= 0xd7a3) ||
      (cp >= 0xf900 && cp <= 0xfaff) ||
      (cp >= 0xfe10 && cp <= 0xfe19) ||
      (cp >= 0xfe30 && cp <= 0xfe6f) ||
      (cp >= 0xff00 && cp <= 0xff60) ||
      (cp >= 0xffe0 && cp <= 0xffe6) ||
      (cp >= 0x1f300 && cp <= 0x1faff) ||
      (cp >= 0x20000 && cp <= 0x3fffd)
    )
  ) return 2;
  return 1;
}

function displayWidth(text) {
  let width = 0;
  for (const ch of String(text || '')) width += charDisplayWidth(ch);
  return width;
}

function truncateDisplay(text, maxWidth) {
  text = String(text || '');
  if (maxWidth <= 0) return '';
  if (displayWidth(text) <= maxWidth) return text;
  if (maxWidth <= 1) return '…';

  let out = '';
  let used = 0;
  for (const ch of text) {
    const w = charDisplayWidth(ch);
    if (used + w + 1 > maxWidth) break;
    out += ch;
    used += w;
  }
  return `${out}…`;
}

function compactPath(filePath) {
  if (!filePath) return '';
  const parts = String(filePath).split(/[\\/]+/).filter(Boolean);
  if (parts.length <= 2) return parts.join('\\');
  return `${parts[parts.length - 2]}\\${parts[parts.length - 1]}`;
}

function makeBar(value, total, width = 14) {
  if (!total) return `[${'░'.repeat(width)}]`;
  const ratio = Math.max(0, Math.min(1, value / total));
  const filled = Math.min(width, Math.floor(ratio * width));
  return `[${'█'.repeat(filled)}${'░'.repeat(width - filled)}]`;
}

class TerminalProgress {
  constructor(total, { label = '扫描', quiet = false } = {}) {
    this.total = total;
    this.label = label;
    this.quiet = quiet;
    this.done = 0;
    this.reused = 0;
    this.relocated = 0;
    this.hashed = 0;
    this.failed = 0;
    this.status = '准备';
    this.file = '';
    this.detail = '';
    this.lastRender = 0;
    this.lastLine = '';
    this.lastNonTtyDone = -1;
    this.dynamic = Boolean(process.stdout.isTTY && !quiet);
  }

  update(patch = {}, force = false) {
    Object.assign(this, patch);
    const now = Date.now();
    // TTY 下最多约 8 帧/秒；扫描缓存时不会按“每本书”疯狂刷新。
    if (!force && now - this.lastRender < 125) return;
    this.lastRender = now;
    this.render(force);
  }

  render(force = false) {
    if (this.quiet) return;

    const current = Math.min(this.total, Math.max(0, this.done));
    const pct = this.total ? Math.floor((current / this.total) * 100) : 100;
    const action = this.detail ? `${this.status} ${this.detail}` : this.status;
    const bar = makeBar(current, this.total, 14);

    // 故意保持单行、短行。上一版之所以“不断输出”，就是长行在终端自动换行后，\r 无法回到上一视觉行。
    let line = `${bar} ${String(pct).padStart(3)}% ${current}/${this.total}  ${action}`;
    line += `  缓存:${this.reused}`;
    if (this.relocated) line += ` 移动:${this.relocated}`;
    line += ` 指纹:${this.hashed}`;
    if (this.failed) line += ` 失败:${this.failed}`;

    const maxWidth = Math.max(38, Math.min(terminalWidth() - 2, 118));
    const shortFile = compactPath(this.file);
    if (shortFile) {
      const remaining = maxWidth - displayWidth(line) - 3;
      if (remaining >= 10) line += `  ${truncateDisplay(shortFile, remaining)}`;
    }
    line = truncateDisplay(line, maxWidth);

    if (this.dynamic) {
      if (!force && line === this.lastLine) return;
      this.lastLine = line;
      process.stdout.write(`\r\x1b[2K${line}`);
      return;
    }

    // 被重定向到日志/非交互环境时，不使用光标控制；每 250 本才落一行。
    if (force || this.done === this.total || (this.done > 0 && this.done % 250 === 0 && this.done !== this.lastNonTtyDone)) {
      this.lastNonTtyDone = this.done;
      console.log(line);
    }
  }

  finish() {
    this.file = '';
    this.detail = '';
    this.status = '完成';
    this.done = this.total;
    this.render(true);
    if (this.dynamic) process.stdout.write('\n');
  }

  clear() {
    if (this.dynamic) {
      process.stdout.write('\r\x1b[2K');
      this.lastLine = '';
    }
  }
}

