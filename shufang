const IGNORE_FILES = new Set(['.DS_Store', 'Thumbs.db', 'desktop.ini']);
const SOURCE_NOISE_PATTERNS = [
  /\s*\((?:z[- ]?library|z-lib(?:rary)?(?:\.[^)]+)?|1lib(?:\.[^)]+)?)[^)]*\)\s*/gi,
  /\s*\[(?:z[- ]?library|z-lib(?:rary)?)[^\]]*\]\s*/gi,
