  const message = typeof warning === 'string' ? warning : (warning?.message || String(warning || ''));
  const name = typeof warning === 'object' && warning ? String(warning.name || '') : '';
  if (/SQLite is an experimental feature/i.test(message)) return;
  return originalEmitWarning(warning, ...args);
};
