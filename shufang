    source_jump: String(openTarget.from || '') === 'note',
  }), 'utf8').toString('base64');

  if (!READER_TEMPLATE_CACHE) {
    READER_TEMPLATE_CACHE = fs.readFileSync(READER_TEMPLATE_PATH, 'utf8');
  }
  return READER_TEMPLATE_CACHE
    .replace('__TITLE_HTML__', () => escapeHtml(item.title || '阅读'))
    .replace('__BOOT_B64__', bootB64);
}

function normalizeRelativeForUi(relativePath) {
  return String(relativePath || '').replaceAll('\\', '/').replace(/^\/+/, '');
}

function topDirectory(relativePath) {
  const rel = normalizeRelativeForUi(relativePath);
  const i = rel.indexOf('/');
  return i < 0 ? '根目录' : rel.slice(0, i);
}

function queryBooks(db, libraryId, { q = '', dir = '', type = '', author = '', reading = '', sort = 'directory' } = {}) {
  const like = `%${q}%`;
  const dirNorm = cleanText(dir).replaceAll('\\', '/').replace(/^\/+|\/+$/g, '');
  const extNorm = cleanText(type).toLowerCase();
  const authorNorm = cleanText(author);
  const readingOnly = cleanText(reading) === 'active' ? 1 : 0;
  const titleExpr = `COALESCE(NULLIF(p.preferred_local_title,''),f.title)`;
  const authorExpr = `COALESCE(NULLIF(p.preferred_local_author,''),f.author)`;
  const orderBy = {
    directory: `MIN(REPLACE(l.relative_path, char(92), '/')) COLLATE NOCASE, ${titleExpr} COLLATE NOCASE`,
    title: `CASE WHEN ${titleExpr}='' THEN 1 ELSE 0 END, ${titleExpr} COLLATE NOCASE, ${authorExpr} COLLATE NOCASE`,
    author: `CASE WHEN ${authorExpr}='' THEN 1 ELSE 0 END, ${authorExpr} COLLATE NOCASE, ${titleExpr} COLLATE NOCASE`,
    recent_read: `CASE WHEN rp.last_read_at IS NULL THEN 1 ELSE 0 END, rp.last_read_at DESC, ${titleExpr} COLLATE NOCASE`,
    size_desc: `f.size DESC, ${titleExpr} COLLATE NOCASE`,
    size_asc: `f.size ASC, ${titleExpr} COLLATE NOCASE`,
    format: `f.ext COLLATE NOCASE, ${titleExpr} COLLATE NOCASE`,
  }[sort] || `MIN(REPLACE(l.relative_path, char(92), '/')) COLLATE NOCASE, ${titleExpr} COLLATE NOCASE`;

  const rows = db.prepare(`
    SELECT f.hash,${titleExpr} AS title,${authorExpr} AS author,
           f.title AS canonical_title,f.author AS canonical_author,
           f.isbn,f.publisher,f.series,f.volume,f.ext,f.size,f.confidence,f.metadata_source,
           p.set_info,p.edition_info,
           COALESCE(rp.progress,0) AS reading_progress,rp.page AS reading_page,
           rp.total_pages AS reading_total_pages,rp.last_read_at,rp.completed_at,
           MIN(l.relative_path) AS relative_path,
           COUNT(*) AS copies
    FROM files f
    JOIN locations l ON l.hash=f.hash
    LEFT JOIN book_local_profile p ON p.library_id=l.library_id AND p.hash=f.hash
    LEFT JOIN reading_progress rp ON rp.library_id=l.library_id AND rp.hash=f.hash
    WHERE l.library_id=?
      AND (?='' OR ${titleExpr} LIKE ? OR ${authorExpr} LIKE ? OR f.title LIKE ? OR f.author LIKE ? OR l.relative_path LIKE ?)
      AND (?='' OR lower(f.ext)=?)
      AND (?='' OR ${authorExpr} LIKE ?)
      AND (?=0 OR (COALESCE(rp.progress,0)>0 AND COALESCE(rp.progress,0)<0.995))
      AND (
        ?='' OR
        (?='__ROOT__' AND instr(REPLACE(l.relative_path, char(92), '/'), '/')=0) OR
        (?<>'__ROOT__' AND substr(REPLACE(l.relative_path, char(92), '/'),1,length(?)+1)=?||'/')
      )
    GROUP BY f.hash
    ORDER BY ${orderBy}
    LIMIT 10000
  `).all(
    libraryId,
    q, like, like, like, like, like,
    extNorm, extNorm,
    authorNorm, `%${authorNorm}%`,
    readingOnly,
    dirNorm, dirNorm,
    dirNorm, dirNorm, dirNorm
  );
  return rows.map(r => ({
    ...r,
    reading_progress: Math.max(0, Math.min(1, Number(r.reading_progress || 0))),
    reading_page: r.reading_page == null ? null : Number(r.reading_page),
    reading_total_pages: r.reading_total_pages == null ? null : Number(r.reading_total_pages),
    sizeText: humanSize(Number(r.size)),
    category: topDirectory(r.relative_path),
  }));
}

function authorFacetNames(author) {
  const raw = cleanText(author);
  if (!raw) return [];
  let parts = raw.split(/\s*(?:&|＆|、|;|；)\s*/u).filter(Boolean);
  if (parts.length === 1 && raw.includes('，')) {
    const commaParts = raw.split(/\s*，\s*/u).filter(Boolean);
    if (commaParts.length > 1 && commaParts.length <= 8 && commaParts.every(x => cleanText(x).length <= 24)) parts = commaParts;
  }
  return [...new Set(parts.map(cleanText).filter(x => x && x.length <= 60))];
}

function getFacets(db, libraryId) {
  const rows = db.prepare(`
    SELECT l.hash,l.relative_path,f.ext,COALESCE(NULLIF(p.preferred_local_author,''),f.author) author
    FROM locations l JOIN files f ON f.hash=l.hash
    LEFT JOIN book_local_profile p ON p.library_id=l.library_id AND p.hash=l.hash
    WHERE l.library_id=?
  `).all(libraryId);
  const dirs = new Map();
  const formats = new Map();
  const authors = new Map();
  for (const row of rows) {
    const rel = normalizeRelativeForUi(row.relative_path);
    const i = rel.indexOf('/');
    const value = i < 0 ? '__ROOT__' : rel.slice(0, i);
    const name = i < 0 ? '根目录' : value;
    if (!dirs.has(value)) dirs.set(value, { name, hashes: new Set() });
    dirs.get(value).hashes.add(row.hash);
    const ext = String(row.ext || '').toLowerCase();
    if (ext) {
      if (!formats.has(ext)) formats.set(ext, new Set());
      formats.get(ext).add(row.hash);
    }
    for (const name of authorFacetNames(row.author)) {
      if (!authors.has(name)) authors.set(name, new Set());
      authors.get(name).add(row.hash);
    }
  }
  const readingCount = Number(db.prepare(`
    SELECT COUNT(DISTINCT rp.hash) n
    FROM reading_progress rp JOIN locations l ON l.library_id=rp.library_id AND l.hash=rp.hash
    WHERE rp.library_id=? AND rp.progress>0 AND rp.progress<0.995
  `).get(libraryId)?.n || 0);
  return {
    readingCount,
    directories: [...dirs.entries()]
      .map(([value, v]) => ({ value, name: v.name, count: v.hashes.size }))
      .sort((a, b) => a.name.localeCompare(b.name, 'zh-CN')),
    formats: [...formats.entries()]
      .map(([value, hashes]) => ({ value, name: value.replace('.', '').toUpperCase(), count: hashes.size }))
      .sort((a, b) => a.name.localeCompare(b.name)),
    authors: [...authors.entries()]
      .map(([name, hashes]) => ({ name, count: hashes.size }))
      .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN')),
  };
}


function shouldIgnoreTreeEntry(name) {
  return name === '.DS_Store' || name === 'Thumbs.db' || name === 'desktop.ini' || name.startsWith('._') || /^rename-log-.*\.json$/i.test(name);
}

async function buildActualDirectoryTree(root) {
  const lines = [root];
  let count = 0;
  const MAX_ENTRIES = 30000;

  async function walk(dir, prefix) {
    if (count >= MAX_ENTRIES) return;
    let entries;
    try {
      entries = await fsp.readdir(dir, { withFileTypes: true });
    } catch {
      lines.push(prefix + '└── [无法读取]');
      return;
    }
    entries = entries
      .filter(e => !shouldIgnoreTreeEntry(e.name))
      .sort((a, b) => {
        if (a.isDirectory() !== b.isDirectory()) return a.isDirectory() ? -1 : 1;
        return a.name.localeCompare(b.name, 'zh-CN', { numeric: true, sensitivity: 'base' });
      });

    for (let i = 0; i < entries.length; i++) {
      if (count >= MAX_ENTRIES) {
        lines.push(prefix + '└── …（目录过大，已截断）');
        return;
      }
      const entry = entries[i];
      const last = i === entries.length - 1;
      lines.push(prefix + (last ? '└── ' : '├── ') + entry.name + (entry.isDirectory() ? '/' : ''));
      count++;
      if (entry.isDirectory()) {
        await walk(path.join(dir, entry.name), prefix + (last ? '    ' : '│   '));
      }
    }
  }

  await walk(root, '');
  return lines.join('\n');
}

