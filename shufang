    ORDER BY id LIMIT 2
  `);
  const fileMetaStmt = db.prepare('SELECT title,author,metadata_source,metadata_version FROM files WHERE hash=?');
  const upsertLocStmt = db.prepare(`
    INSERT INTO locations(library_id,hash,relative_path,absolute_path,size,mtime_ms,file_dev,file_ino,last_seen_scan)
    VALUES(?,?,?,?,?,?,?,?,?)
    ON CONFLICT(library_id,relative_path) DO UPDATE SET
      hash=excluded.hash,
      absolute_path=excluded.absolute_path,
      size=excluded.size,
      mtime_ms=excluded.mtime_ms,
      file_dev=excluded.file_dev,
      file_ino=excluded.file_ino,
