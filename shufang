function encodeEpubEntryUrl(entry){return String(entry||'').split('/').map(encodeURIComponent).join('/')}

function errorText(error) {
  if (error == null) return '';
  if (typeof error === 'string') return error;

  // PDF.js 某些异常对象的 stack 只有裸的 "Error\n at ..."，
  // 真正的异常类型和原因只存在于 name/message 中，因此必须合并判断。
  const parts = [error?.name, error?.message, error?.stack]
    .filter(Boolean)
    .map(String);
  if (parts.length) return [...new Set(parts)].join('\n');
  try { return String(error); } catch { return ''; }
