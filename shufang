}

// 阅读器优先级：后台封面维护必须主动让路给正在阅读的 PDF/EPUB/TXT。
let readerActivityUntil = 0;
function markReaderActivity(ms = 15000) {
  readerActivityUntil = Math.max(readerActivityUntil, Date.now() + Math.max(1000, Number(ms) || 0));
}
async function waitForReaderIdle() {
  while (Date.now() < readerActivityUntil) {
    await new Promise(resolve => setTimeout(resolve, Math.min(1200, Math.max(120, readerActivityUntil - Date.now()))));
  }
}

// 阅读器的 PDF 渲染与主进程隔离：损坏 PDF、PDF.js 内部 rejection、原生 Canvas 异常
// 都只允许影响阅读 worker，绝不能击穿书房 Web 服务。页面按 SHA-256 缓存到磁盘。
const READER_CACHE_DIR = path.join(APP_DIR, 'reader-cache');
const PDF_READER_CACHE_DIR = path.join(READER_CACHE_DIR, 'pdf');
const PDF_WORKER_SCRIPT = path.join(__dirname, 'shufang-pdf-worker.js');
const pdfWorkerSessions = new Map();
const pdfInfoCache = new Map();
let pdfWorkerSeq = 0;
const PDF_WORKER_IDLE_MS = 3 * 60 * 1000;
const PDF_WORKER_TIMEOUT_MS = 80000;
const PDF_WORKER_MAX_SESSIONS = 2;

function sanitizePdfWidth(value) {
  return Math.max(300, Math.min(1800, Math.round((Number(value) || 1100) / 50) * 50));
}

function pdfReaderCachePath(hash, page, width) {
  return path.join(PDF_READER_CACHE_DIR, hash.slice(0, 2), hash, String(width), `${page}.png`);
}

function stopPdfWorkerSession(session) {
  if (!session) return;
  try { clearTimeout(session.idleTimer); } catch {}
  for (const { reject, timer } of session.pending.values()) {
    try { clearTimeout(timer); } catch {}
    try { reject(new Error('PDF 阅读进程已结束')); } catch {}
  }
  session.pending.clear();
  try { session.child?.kill(); } catch {}
  if (pdfWorkerSessions.get(session.hash) === session) pdfWorkerSessions.delete(session.hash);
}

function touchPdfWorkerSession(session) {
  session.lastUsed = Date.now();
  try { clearTimeout(session.idleTimer); } catch {}
  session.idleTimer = setTimeout(() => stopPdfWorkerSession(session), PDF_WORKER_IDLE_MS);
  session.idleTimer.unref?.();
}

function enforcePdfWorkerLimit(exceptHash = '') {
  while (pdfWorkerSessions.size >= PDF_WORKER_MAX_SESSIONS) {
    let victim = null;
    for (const session of pdfWorkerSessions.values()) {
      if (session.hash === exceptHash) continue;
      if (!victim || session.lastUsed < victim.lastUsed) victim = session;
    }
    if (!victim) break;
    stopPdfWorkerSession(victim);
  }
}

function getPdfWorkerSession(item) {
  const hash = String(item.hash || '');
  let session = pdfWorkerSessions.get(hash);
  if (session && session.absolutePath === item.absolute_path && session.child?.connected) {
    touchPdfWorkerSession(session);
    return session;
  }
  if (session) stopPdfWorkerSession(session);
  if (!fs.existsSync(PDF_WORKER_SCRIPT)) {
    throw new Error(`缺少 PDF 阅读组件：${path.basename(PDF_WORKER_SCRIPT)}。请完整解压书房压缩包后再运行。`);
  }
  enforcePdfWorkerLimit(hash);
  const child = fork(PDF_WORKER_SCRIPT, [], {
    cwd: __dirname,
    windowsHide: true,
    stdio: ['ignore', 'ignore', 'pipe', 'ipc'],
  });
  session = {
    hash,
    absolutePath: item.absolute_path,
    child,
    pending: new Map(),
    stderr: '',
    lastUsed: Date.now(),
    idleTimer: null,
  };
  child.stderr?.setEncoding('utf8');
  child.stderr?.on('data', chunk => { session.stderr = (session.stderr + chunk).slice(-12000); });
  child.on('message', msg => {
    const id = Number(msg?.id);
    const pending = session.pending.get(id);
    if (!pending) return;
    session.pending.delete(id);
    clearTimeout(pending.timer);
    if (msg?.ok) pending.resolve(msg.result || {});
    else pending.reject(new Error(cleanText(msg?.error || session.stderr || 'PDF 阅读进程执行失败')));
  });
  child.on('error', error => {
    const text = error?.message || String(error);
    for (const pending of session.pending.values()) { clearTimeout(pending.timer); pending.reject(new Error(text)); }
    session.pending.clear();
  });
  child.on('exit', (code, signal) => {
    const reason = cleanText(session.stderr) || `PDF 阅读进程退出（code=${code ?? '-'}${signal ? `, signal=${signal}` : ''}）`;
    for (const pending of session.pending.values()) { clearTimeout(pending.timer); pending.reject(new Error(reason)); }
    session.pending.clear();
    if (pdfWorkerSessions.get(hash) === session) pdfWorkerSessions.delete(hash);
  });
  pdfWorkerSessions.set(hash, session);
  touchPdfWorkerSession(session);
  return session;
}

function requestPdfWorker(item, action, payload = {}) {
  markReaderActivity(18000);
  const session = getPdfWorkerSession(item);
  touchPdfWorkerSession(session);
  const id = ++pdfWorkerSeq;
  return new Promise((resolve, reject) => {
    const timer = setTimeout(() => {
      session.pending.delete(id);
      stopPdfWorkerSession(session);
      reject(new Error(`PDF ${action === 'info' ? '解析' : '页面渲染'}超时`));
    }, PDF_WORKER_TIMEOUT_MS);
    session.pending.set(id, { resolve, reject, timer });
    try {
      session.child.send({ id, action, filePath: item.absolute_path, ...payload });
    } catch (error) {
      clearTimeout(timer);
      session.pending.delete(id);
      reject(error);
    }
  });
}

async function getPdfReaderInfo(item) {
  const cached = pdfInfoCache.get(item.hash);
  if (cached && cached.absolutePath === item.absolute_path) return cached.info;
  const info = await requestPdfWorker(item, 'info');
  if (!Number(info?.pages || 0)) throw new Error('PDF 没有可读取的页面');
  pdfInfoCache.set(item.hash, { absolutePath: item.absolute_path, info });
  return info;
}

async function renderPdfReaderPage(item, pageNo, requestedWidth) {
  const page = Math.max(1, Math.floor(Number(pageNo) || 1));
  const width = sanitizePdfWidth(requestedWidth);
  const target = pdfReaderCachePath(item.hash, page, width);
  try {
    const stat = await fsp.stat(target);
    if (stat.isFile() && stat.size > 100) return { path: target, size: stat.size, cached: true };
  } catch {}
  await ensureDir(path.dirname(target));
  const result = await requestPdfWorker(item, 'render', { page, width, target });
  const stat = await fsp.stat(target);
  if (!stat.isFile() || stat.size < 100) throw new Error(result?.error || 'PDF 页面渲染结果为空');
  return { path: target, size: stat.size, cached: false, width: result?.width, height: result?.height };
}

// EPUB 不再依赖浏览器 epub.js / JSZip。Node 只解析 EPUB 包结构并按原始目录提供资源，
// 浏览器 iframe 负责显示章节；这样不再存在 “JSZip lib not loaded” 一类运行时依赖问题。
const epubReaderSessions = new Map();
const EPUB_READER_IDLE_MS = 3 * 60 * 1000;
const EPUB_READER_MAX_SESSIONS = 4;

function listify(value) { return Array.isArray(value) ? value : value == null ? [] : [value]; }
