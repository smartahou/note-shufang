      const page=await pdf.getPage(1);const base=page.getViewport({scale:1});
      const scale=Math.min(2.0,360/base.width,520/base.height);const vp=page.getViewport({scale:Math.max(.15,scale)});
      canvas.width=Math.max(1,Math.ceil(vp.width));canvas.height=Math.max(1,Math.ceil(vp.height));
