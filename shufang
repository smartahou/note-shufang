function decodeMaybe(s) {
  if (!s.includes('%')) return s;
  try { return decodeURIComponent(s); } catch { return s; }
}

function cleanText(s) {
  if (s == null) return '';
  return String(s)
    .replace(/[\u0000-\u001f]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function cleanFileStem(filename) {
  let s = path.basename(filename, path.extname(filename));
  s = decodeMaybe(s);
  s = s.replace(/^\._/, '');
  for (const re of SOURCE_NOISE_PATTERNS) s = s.replace(re, ' ');
  s = s
    .replace(/\s+/g, ' ')
    .replace(/[._-]+\s*$/, '')
    .trim();
  return s;
}

function normalizeForCompare(s) {
  return cleanText(s)
    .toLowerCase()
    .replace(/[《》【】\[\]()（）“”‘’'"：:·•,，.。!！?？\s_\-—–\uE000-\uF8FF]/g, '');
}

function similarity(a, b) {
  a = normalizeForCompare(a);
  b = normalizeForCompare(b);
  if (!a || !b) return 0;
  if (a === b) return 1;
  if (a.includes(b) || b.includes(a)) return Math.min(a.length, b.length) / Math.max(a.length, b.length) * 0.9 + 0.1;

  // Dice coefficient on bigrams, 足够用于书名候选粗匹配。
  const grams = s => {
    if (s.length < 2) return [s];
    const arr = [];
    for (let i = 0; i < s.length - 1; i++) arr.push(s.slice(i, i + 2));
    return arr;
  };
  const aa = grams(a);
  const bb = grams(b);
  const counts = new Map();
  for (const x of aa) counts.set(x, (counts.get(x) || 0) + 1);
  let inter = 0;
  for (const x of bb) {
    const c = counts.get(x) || 0;
    if (c > 0) {
      inter++;
      counts.set(x, c - 1);
    }
  }
  return (2 * inter) / (aa.length + bb.length);
}


function looksLikePromotionalTitleSuffix(text) {
  const s = cleanText(text);
  if (!s) return false;

  // 明确的套装/版本/宣传标签。这里宁可保守，只删除高度像“营销文案/装帧说明”的尾巴。
  if (/^(?:套装|全套|合集|珍藏|典藏|精装|平装|修订|增订|新版|全新|纪念|插图|图文|文字版|扫描版|电子版|完整版|共\s*\d+\s*册|全\s*[一二三四五六七八九十百两0-9]+\s*册|第\s*[一二三四五六七八九十百两0-9]+\s*版|第\s*[一二三四五六七八九十百两0-9]+\s*册)/u.test(s)) return true;
  if (/(?:出品|重磅|推荐|力荐|畅销|必读|必看|口碑|获奖|荣获|年度|销量| bestseller|独家首发|独家|首发|名家推荐|大师推荐|媒体推荐|豆瓣|当当|京东)/iu.test(s)) return true;
  if (/(?:一部|一本|一套|带你|揭秘|揭示|讲透|读懂|了解|看懂|完整呈现|全景|经典之作|扛鼎之作|代表作|重磅新作)/u.test(s) && /[！!，,；;。]/u.test(s)) return true;
  const punctuationCount = (s.match(/[！!，,；;。]/gu) || []).length;
  if (s.length >= 24 && (/[！!]/u.test(s) || punctuationCount >= 2)) return true;
  return false;
}

function cleanCanonicalTitle(title) {
  let t = cleanText(title);
  if (!t) return '';
  let previous = '';
  // 连续剥离尾部的宣传方括号/括号，例如：
  // 中国文化通史【北师大出品！一部……】
  // 历史的温度（套装共2册）（一个个有温度的故事……）
  while (t && t !== previous) {
    previous = t;
    t = t.replace(/\s*【([^】]{2,320})】\s*$/u, (all, inner) => looksLikePromotionalTitleSuffix(inner) ? '' : all).trim();
    t = t.replace(/\s*[（(]([^()（）]{2,320})[）)]\s*$/u, (all, inner) => looksLikePromotionalTitleSuffix(inner) ? '' : all).trim();
  }
  t = t.replace(/^《(.+)》$/u, '$1').trim();
  return cleanText(t);
}

function reconcileTitleWithFilename(metadataTitle, fallbackTitle) {
  const embedded = cleanCanonicalTitle(metadataTitle);
  const fallback = cleanCanonicalTitle(fallbackTitle);
  if (!embedded) return fallback;
  if (!fallback) return embedded;

  const a = normalizeForCompare(embedded);
  const b = normalizeForCompare(fallback);
  if (!a || !b) return embedded;

  // 当文件名给出了一个清晰、较短的主标题，而 EPUB/PDF metadata 只是在它后面
  // 拼接宣传语/套装说明时，优先显示主标题。
  if (a.includes(b) && a.length >= b.length + 4 && a.length > b.length * 1.18) return fallback;

  // “《老子》通识”这类结构中，书名号里的词只是主标题的一部分，后面的“通识”
  // 仍属于正式书名。旧解析器会把它误判为作者并截成“老子”。
  const quoted = fallback.match(/^《([^》]+)》(.+)$/u);
  if (quoted && cleanText(quoted[2]) && normalizeForCompare(quoted[1]) === a) return fallback;
  return embedded;
}

function isLikelyAuthorDir(name) {
  let s = cleanFileStem(name)
    .replace(/^《.*》.*$/, '')
    .trim();
  if (!s) return false;
  if (/^(?:pdf|epub|txt|电子书|书籍|图书|资料|合集|待读|待读|未读|已读|其他|杂书|格物|大人物|小说|历史|哲学|宗教|佛教|道教|计算机|文学|政治|经济|传记)$/i.test(s)) return false;
  if (/\d{4}年/.test(s)) return false;
  if (/^(?:第?\d+|\d+)$/.test(s)) return false;
  if (/^[\p{Script=Han}·•.]{2,10}$/u.test(s)) return true;
  if (/^[A-Za-z][A-Za-z .'-]{2,40}$/.test(s) && s.split(/\s+/).length <= 5) return true;
  return false;
}

function looksLikeMojibake(s) {
  const text = cleanText(s);
  if (!text) return false;
  const chars = [...text];
  if (!chars.length) return false;

  let replacement = 0;
  let c1 = 0;
  let odd = 0;
  let latin1Odd = 0;
  let han = 0;

  for (const ch of chars) {
    const cp = ch.codePointAt(0);
    if (ch === '\uFFFD') replacement++;
    if (cp >= 0x80 && cp <= 0x9f) c1++;
    if (/\p{Script=Han}/u.test(ch)) han++;
    if (!/[\p{L}\p{N}\s]/u.test(ch) && !/[《》【】\[\]()（）“”‘’'":：·•,，.。!！?？_\-—–+&/]/u.test(ch)) odd++;
    if (cp >= 0xa0 && cp <= 0xff) latin1Odd++;
  }

  if (replacement > 0 || c1 > 0) return true;
  if (/(?:Ã.|Â.|Ð.|Ñ.|â.|å.|æ.|ç.|¤|¦|¨|¬|±|´|µ|¿){2,}/u.test(text)) return true;
  if (chars.length >= 6 && odd / chars.length > 0.22) return true;
  if (han === 0 && chars.length >= 6 && latin1Odd / chars.length > 0.18) return true;
  return false;
}

function looksLikeGarbagePdfMetadata(s) {
  const raw = cleanText(s);
  const v = raw.toLowerCase();
  if (!v) return true;
  return looksLikeMojibake(raw)
    || /^(?:untitled|unknown|administrator|admin|microsoft word|document|acrobat|pdf|扫描|scan|scanner)/i.test(v)
    || /\.docx?$|\.pdf$/i.test(v)
    || v.length > 250;
}

function embeddedFieldIsWorse(embedded, fallback) {
  embedded = cleanText(embedded);
  fallback = cleanText(fallback);
  if (!embedded) return true;
  if (looksLikeGarbagePdfMetadata(embedded)) return true;
  if (!fallback) return false;

  const fallbackHasHan = /\p{Script=Han}/u.test(fallback);
  const embeddedHasHan = /\p{Script=Han}/u.test(embedded);
  if (fallbackHasHan && !embeddedHasHan && similarity(embedded, fallback) < 0.18) {
    const symbols = [...embedded].filter(ch => !/[\p{L}\p{N}\s]/u.test(ch)).length;
    if (symbols / Math.max(1, [...embedded].length) > 0.12) return true;
  }
  return false;
}

function filenameTitleIsUseful(fallback) {
  const title = cleanText(fallback?.title || '');
  const norm = normalizeForCompare(title);
  if (!norm || norm.length < 4) return false;
  if (/^(?:unknown|untitled|document|scan|扫描|电子书|book)\d*$/i.test(norm)) return false;
  if (/^(?:\d{1,4}|\d{1,3}-\d{1,3})$/.test(title)) return false;
  return Number(fallback?.confidence || 0) >= 0.55;
}

function embeddedTitleConflictsWithFilename(embeddedTitle, fallback) {
  const embedded = cleanText(embeddedTitle);
  const fileTitle = cleanText(fallback?.title || '');
  if (!embedded || !fileTitle || !filenameTitleIsUseful(fallback)) return false;
  if (looksLikeGarbagePdfMetadata(embedded)) return true;

  const score = similarity(embedded, fileTitle);
  if (score >= 0.42) return false;

  const a = normalizeForCompare(embedded);
  const b = normalizeForCompare(fileTitle);
  if (!a || !b) return false;
  if (a.includes(b) || b.includes(a)) return false;

  const aHan = (embedded.match(/\p{Script=Han}/gu) || []).length;
  const bHan = (fileTitle.match(/\p{Script=Han}/gu) || []).length;
  const bothChinese = aHan >= 2 && bHan >= 2;

  if (score < 0.16) return true;
  if (bothChinese && score < 0.24) return true;
  if (Number(fallback?.confidence || 0) >= 0.78 && score < 0.30) return true;
  return false;
}

function validateEmbeddedMetadata(embedded, fallback) {
  if (!embedded) return null;
  const out = { ...embedded };
  out.title = cleanCanonicalTitle(out.title || '');

  const titleRejected =
    embeddedFieldIsWorse(out.title, fallback?.title) ||
    (String(embedded.source || '').startsWith('pdf-metadata') &&
      embeddedTitleConflictsWithFilename(out.title, fallback));

  if (titleRejected) out.title = '';
  if (embeddedFieldIsWorse(out.author, fallback?.author)) out.author = '';

  if (titleRejected &&
      String(embedded.source || '').startsWith('pdf-metadata') &&
      fallback?.author &&
      out.author &&
      similarity(out.author, fallback.author) < 0.22) {
    out.author = '';
  }

  if (!out.title && !out.author && !out.isbn) return null;
  if (!out.title || !out.author) out.confidence = Math.min(Number(out.confidence || 0), out.title ? 0.86 : 0.72);
  return out;
}

function looksLikeSeriesLabel(label) {
  const s = cleanText(label);
  if (!s || s.length > 30) return false;
  // [美]、[英] 之类通常是作者国籍，不是丛书标签。
  if (/^(?:美|英|法|德|日|俄|加|澳|奥|意|西|韩|印|瑞|荷|挪|芬|丹|希|苏|巴西|新西兰)$/u.test(s)) return false;
  return /(?:系列|丛书|文库|书系|新知|译丛|纪实|出品|读库|见识|思想|学术|经典|出版|图灵|甲骨文|理想国|新民说|中信|未读|博集|果麦|湛庐|企鹅|后浪|午夜|译文|汉译|汗青堂|索恩|方寸|守望者)/u.test(s);
}

function looksLikeContextLabel(label) {
  const s = cleanText(label);
  if (!s || s.length > 36) return false;
  if (looksLikeSeriesLabel(s)) return true;
  // 这类方括号内容常常是“课程/栏目/合集标签”，不是实际书名。
  // 例如：[中国现代文学史全讲]国文国史三十年 孔庆东
  return /(?:全讲|精讲|讲座|课程|课堂|专题|书单|合集|导读|选读|赏析|解读|讲义|资料集|读书会|名家讲|名师讲|百家讲坛|公开课)/u.test(s);
}

function stripLeadingSeriesLabel(stem) {
  const text = cleanText(stem);
  const m = text.match(/^\s*(?:【([^】]{1,36})】|\[([^\]]{1,36})\])\s*(.+)$/u);
  if (!m) return { stem: text, series: '', stripped: false, kind: '' };
  const label = cleanText(m[1] || m[2] || '');
  const rest = cleanText(m[3] || '');
  // [书名].作者.扫描版 这一类方括号本身就是书名，不是系列标签。
  // 系列/课程前缀正常情况下会直接接真正书名，而不是以点号等书目分隔符开头。
  if (/^[.·_]/u.test(rest) || !looksLikeContextLabel(label) || normalizeForCompare(rest).length < 4) {
    return { stem: text, series: '', stripped: false, kind: '' };
  }
  return {
    stem: rest,
    series: label,
    stripped: true,
    kind: looksLikeSeriesLabel(label) ? 'series' : 'context',
  };
}

function splitSimpleTrailingAuthor(stem) {
  const text = cleanText(stem);
  if (!text) return { title: '', author: '', matched: false };

  // 保守处理“书名 作者”形式：只认 2~8 个汉字/间隔点组成的人名，
  // 且书名部分至少有 4 个可比较字符，避免把普通标题最后一个词误当作者。
  const m = text.match(/^(.+?)\s+([\p{Script=Han}·•]{2,8})(?:\s*(?:著|编著|主编|编|译))?$/u);
  if (!m) return { title: '', author: '', matched: false };
  const title = cleanText(m[1]);
  const author = cleanText(m[2]);
  if (normalizeForCompare(title).length < 4 || !isLikelyAuthorDir(author)) {
    return { title: '', author: '', matched: false };
  }
  return { title, author, matched: true };
}

function looksLikeAuthorTail(text) {
  const t = cleanText(text);
  if (!t || t.length > 80) return false;
  if (/(?:出版社|出版公司|出版集团|19\d{2}|20\d{2}|套装|全\d+册|丛书|系列)/u.test(t)) return false;
  if (/(?:著|编著|主编|编|译|编绘|绘|等文|文)(?:\s|$|[.，,、;&])/u.test(t)) return true;
  if (/^[\p{Script=Han}·•]{2,14}$/u.test(t)) return true;
  if (/^[A-Za-z][A-Za-z .'-]{2,50}$/u.test(t) && t.split(/\s+/).length <= 5) return true;
  return false;
}

function splitBibliographicTail(stem) {
  const text = cleanText(stem);
  // 常见下载文件名：书名 [美]作者著 译者译 出版社2010
  const m = text.match(/^(.+?)\s*(?:\[([^\]]{1,8})\]|【([^】]{1,8})】|[（(]([^）)]{1,8})[）)])\s*(.+)$/u);
  if (m) {
    const country = cleanText(m[2] || m[3] || m[4] || '');
    if (/^(?:美|英|法|德|日|俄|加|澳|奥|意|西|韩|印|瑞|荷|挪|芬|丹|希|苏|巴西|新西兰)$/u.test(country)) {
      const title = cleanText(m[1]);
      const tail = cleanText(m[5]);
      let author = '';
      const am = tail.match(/^(.{1,60}?)(?:编著|主编|著|编)(?:\s|$|[，,、;])/u) || tail.match(/^(.{1,60}?)(?:编著|主编|著|编)/u);
      if (am) author = cleanText(am[1]);
      if (title && normalizeForCompare(title).length >= 2) {
        return { title, author: author ? `[${country}]${author}` : '', matched: true };
      }
    }
  }

  // 英文作者 + 中文出版社年份：标题 Brian Clegg 人民邮电出版社2012
  const latin = text.match(/^(.+?)\s+([A-Z][A-Za-z.'-]+(?:\s+[A-Z][A-Za-z.'-]+){1,3})\s+([\p{Script=Han}]{2,18}(?:出版社|出版公司|出版集团))\s*(?:19|20)\d{2}.*$/u);
  if (latin) {
    return { title: cleanText(latin[1]), author: cleanText(latin[2]), matched: true };
  }
  return { title: '', author: '', matched: false };
}

function filenameHasLeadingSeriesLabel(filePath) {
  return stripLeadingSeriesLabel(cleanFileStem(filePath)).stripped;
}

function extractVolume(text) {
  const patterns = [
    /(第\s*[一二三四五六七八九十百零〇两0-9]+\s*[卷册集部篇])/,
    /([上中下]册)/,
    /([上中下]卷)/,
    /(?:^|\s)(\d{1,3})\s*(?:册|卷|集)(?:\s|$)/,
  ];
  for (const re of patterns) {
    const m = text.match(re);
    if (m) return cleanText(m[1]);
  }
  return '';
}

function parseFilenameMetadata(filePath) {
  const ext = path.extname(filePath).toLowerCase();
  const originalStem = cleanFileStem(filePath);
  const parent = path.basename(path.dirname(filePath));
  const grandParent = path.basename(path.dirname(path.dirname(filePath)));

  const seriesInfo = stripLeadingSeriesLabel(originalStem);
  let stem = seriesInfo.stem;
  let title = '';
  let author = '';
  let source = seriesInfo.stripped ? 'filename+series' : 'filename';
  let confidence = seriesInfo.stripped ? 0.82 : 0.56;
  let series = seriesInfo.series || '';

  // “【图灵新知】书名 [美]作者著 出版社2010”之类，先把丛书标签剥离，
  // 再从国籍/作者/出版社尾巴中截出真正书名。
  const bibliographic = splitBibliographicTail(stem);
  if (bibliographic.matched) {
    title = bibliographic.title;
    author = bibliographic.author;
    confidence = author ? 0.9 : 0.86;
  }

  // 对已经确认是“丛书/课程/栏目标签”的前缀，允许继续解析“书名 作者”。
  // 例如：[中国现代文学史全讲]国文国史三十年 孔庆东
  if (!title && seriesInfo.stripped) {
    const trailingAuthor = splitSimpleTrailingAuthor(stem);
    if (trailingAuthor.matched) {
      title = trailingAuthor.title;
      author = trailingAuthor.author;
      confidence = seriesInfo.kind === 'context' ? 0.9 : 0.88;
      source = seriesInfo.kind === 'context' ? 'filename+context' : 'filename+series';
    }
  }

  // [书名].作者.扫描版 / [书名]作者。只有右侧真的“像作者”时才采用，
  // 防止把【丛书标签】后面的整段书目信息误当作者。
  let m = !title ? stem.match(/^\s*[\[【《](.+?)[\]】》](.*)$/u) : null;
  if (m) {
    const tailRaw = String(m[2] || '');
    const tail = cleanText(tailRaw.replace(/^[.· _-]+/u, ''));
    const hasSeparator = /^[\s.·_-]+/u.test(tailRaw);
    const explicitAuthorRole = /(?:主编|编著|著|编|译|编绘|绘|等文|文)\s*$/u.test(tail);
    // “《老子》通识”里的“通识”是书名续接，不是作者。
    // 只有明确分隔，或尾部带作者角色词时，才把右侧解释为作者。
    if (!tail || ((hasSeparator || explicitAuthorRole) && looksLikeAuthorTail(tail))) {
      title = cleanText(m[1]);
      if (tail && !/^(?:扫描版|文字版)$/i.test(tail)) author = tail.replace(/[.· _-]*(?:主编|编著|著|编|译|编绘|绘|等文|文)$/gu, '').replace(/[.· _-]+$/gu, '').trim();
      confidence = author ? 0.9 : 0.78;
    }
  }

  // EPUB 常见：书名 - 作者
  if (!title) {
    const idx = stem.lastIndexOf(' - ');
    if (idx > 1 && idx < stem.length - 3) {
      const left = cleanText(stem.slice(0, idx));
      const right = cleanText(stem.slice(idx + 3));
      if (right.length <= 120) {
        title = left;
        author = right;
        confidence = 0.9;
      }
    }
  }

  // 书名 (作者) —— 取最后一个括号，过滤明显的版本/丛书说明。
  if (!title) {
    m = stem.match(/^(.*?)\s*[（(]([^()（）]{2,100})[）)]\s*$/);
    if (m) {
      const maybeAuthor = cleanText(m[2]);
      // 括号并不天然等于“作者”。年份区间、卷册、版本、丛书等都应保留在标题中。
      // 同时容忍 AI 重命名后留下的轻微尾部标点，例如“（第一辑·）”。
      const maybeAuthorBare = maybeAuthor.replace(/[·•._—–-]+$/u, '').trim();
      const notAuthor =
        /^\d{3,4}\s*[-–—]\s*\d{2,4}$/u.test(maybeAuthorBare) ||
        /^(?:第\s*[一二三四五六七八九十百零〇两0-9]+\s*(?:辑|册|卷|部|集)|[上中下](?:册|卷|篇)|[黄宇天地]册)$/u.test(maybeAuthorBare) ||
        /(?:版|套装|丛书|系列|出版社|修订|增订|珍藏|典藏|全\d+册|第\d+版|出品|译文|译本|文库|读客|博集|新民说|附|上册|中册|下册|上下册|上卷|中卷|下卷|黄册|宇册|天册|地册|精装|平装|(?:册|卷|辑|本|集)$)/i.test(maybeAuthorBare);
      if (!notAuthor) {
        title = cleanText(m[1]);
        author = maybeAuthor
          .replace(/\betc\.?$/i, '')
          .replace(/\bauthor\b/gi, '')
          .replace(/[，,]\s*$/g, '')
          .trim();
        confidence = 0.84;
      }
    }
  }

  // 书名_作者，只对最后一段像人名时采用。
  if (!title) {
    m = stem.match(/^(.*?)[_＿]([^_＿]{2,20})$/);
    if (m && isLikelyAuthorDir(m[2])) {
      title = cleanText(m[1]);
      author = cleanText(m[2]);
      confidence = 0.78;
    }
  }

  // 普通回退。
  if (!title) title = stem;

  // 去掉外围书名号，并剥离明确的套装/宣传尾巴。
  title = cleanCanonicalTitle(title);

  // 文件只有 01.pdf / 1-01.pdf 之类：父目录才是真正语义。
  if (/^(?:\d{1,3}|\d{1,3}-\d{1,3})$/.test(title)) {
    const parentTitle = cleanFileStem(parent)
      .replace(/^《(.+?)》.*$/, '$1')
      .trim();
    if (parentTitle && !/^\d+$/.test(parentTitle)) {
      title = `${parentTitle} ${title}`;
      source = 'filename+parent';
      confidence = 0.72;
    }
  }

  // v7：不再仅凭“父目录看起来像人名”推断作者。
  // 目录角色会在整库扫描结束后，依据多本书的一致作者证据统一判断，
  // 再把明确的 author 目录作为“本地辅助证据”写入 book_local_profile。

  const volume = extractVolume(originalStem) || (/^\d{1,3}$/.test(originalStem) ? originalStem : '');

  return {
    title: cleanText(title) || path.basename(filePath),
    author: cleanText(author),
    isbn: '',
    publisher: '',
    series,
    volume,
    source,
    confidence,
    ext,
  };
}


function normalizeRelKey(value) {
  return String(value || '').replaceAll('\\', '/').replace(/^\.\//, '').replace(/^\/+|\/+$/g, '');
}

function extractSetInfo(text) {
  const s = cleanText(text);
  if (!s) return '';
  const patterns = [
    // “（10本）”“（共8册）”“【套装全三卷】”都是载体/合集信息，不属于书名主体。
    /[（(【\[]([^（）()【】\[\]]{0,80}(?:套装(?:共|全)?\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]?|全套\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]?|共\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]|全\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]|[一二三四五六七八九十百零〇两0-9]+\s*[册本卷])[^（）()【】\[\]]{0,80})[）)】\]]/u,
    /(?:套装(?:共|全)?\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]?|全套\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]|共\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]|全\s*[一二三四五六七八九十百零〇两0-9]+\s*[册本卷]|上下册|上中下册)/u,
  ];
  for (const re of patterns) {
    const m = s.match(re);
    if (m) return cleanText(m[1] || m[0]);
  }
  return '';
}

function extractEditionInfo(text) {
  const s = cleanText(text);
  if (!s) return '';
  const m = s.match(/(?:第\s*[一二三四五六七八九十百两0-9]+\s*版|修订版|增订版|珍藏版|典藏版|纪念版|新版|行卯版|整洁版|中文版|注译本|扫描版|文字版|影印版|原书扫描版|高清扫描版)/u);
  return cleanText(m?.[0] || '');
}

function ensureLocalProfileRow(db, libraryId, hash) {
  db.prepare(`INSERT INTO book_local_profile(library_id,hash) VALUES(?,?) ON CONFLICT(library_id,hash) DO NOTHING`).run(libraryId, hash);
}

function recordNameHistory(db, libraryId, hash, relativePath, filename, source, detail = {}) {
  if (!filename) return;
  db.prepare(`
    INSERT OR IGNORE INTO file_name_history(library_id,hash,relative_path,filename,source,detail_json)
    VALUES(?,?,?,?,?,?)
  `).run(libraryId, hash, normalizeRelKey(relativePath), filename, source, JSON.stringify(detail || {}));
}

function upsertLocalProfile(db, libraryId, hash, relativePath, filePath) {
  ensureLocalProfileRow(db, libraryId, hash);
  const currentName = path.basename(filePath);
  const filenameMeta = parseFilenameMetadata(filePath);
  const existing = db.prepare(`SELECT * FROM book_local_profile WHERE library_id=? AND hash=?`).get(libraryId, hash) || {};
  const originalFilename = cleanText(existing.original_filename || '') || currentName;
  const preferredTitle = cleanText(existing.preferred_local_title || '');
  let preferredAuthor = cleanText(existing.preferred_local_author || '');
  const setInfo = cleanText(existing.set_info || '');
  const editionInfo = cleanText(existing.edition_info || '');

  // v1.10 起这里只维护当前本地文件信息。历史 rename_* 字段不再参与扫描、显示或筛选，
  // 但原值保留在旧数据库中，避免为移除功能而做破坏性 schema 迁移。
  recordNameHistory(db, libraryId, hash, relativePath, currentName, 'observed', { current: true });

  const canonical = db.prepare('SELECT author FROM files WHERE hash=?').get(hash);
  if (!preferredAuthor && cleanText(canonical?.author || '')) preferredAuthor = cleanText(canonical.author);

  db.prepare(`
    UPDATE book_local_profile SET
      current_relative_path=?,current_filename=?,original_filename=?,filename_title=?,filename_author=?,
      preferred_local_title=?,preferred_local_author=?,set_info=?,edition_info=?,
      evidence_json=?,updated_at=CURRENT_TIMESTAMP
    WHERE library_id=? AND hash=?
  `).run(
    normalizeRelKey(relativePath), currentName, originalFilename, filenameMeta.title || '', filenameMeta.author || '',
    preferredTitle, preferredAuthor, setInfo || extractSetInfo(currentName), editionInfo || extractEditionInfo(currentName),
    JSON.stringify({ filenameSource: filenameMeta.source, filenameConfidence: filenameMeta.confidence }),
    libraryId, hash
  );
}

function directoryRoleForName(name) {
  const s = cleanText(name);
  if (!s) return '';
  if (/(?:全集|选集|文集|系列|丛书|书系|译丛|丛刊|合集|汇编|杂志|刊物|教科书|漫画全集)$/u.test(s)) return 'collection';
  if (/^(?:books?|pdf|epub|txt|电子书|书籍|图书|资料|待读|未读|已读|其他|杂书|格物|大人物|小说|历史|哲学|宗教|佛教|道教|术数|计算机|文学|政治|经济|传记|通史|清史|三国|国朝|明鉴|自制|教员|常公)$/iu.test(s)) return 'category';
  if (/^(?:\d{4}年.*|更新_\d+)/u.test(s)) return 'category';
  return '';
}

function ancestorDirs(relativePath) {
  const rel = normalizeRelKey(relativePath);
  const parts = rel.split('/').slice(0, -1);
  const out = [];
  for (let i = 1; i <= parts.length; i++) out.push(parts.slice(0, i).join('/'));
  return out;
}

function rebuildDirectoryRolesAndLocalAuthors(db, libraryId) {
  const rows = db.prepare(`
    SELECT l.hash,l.relative_path,f.author,f.metadata_source,p.preferred_local_author
    FROM locations l JOIN files f ON f.hash=l.hash
    LEFT JOIN book_local_profile p ON p.library_id=l.library_id AND p.hash=l.hash
    WHERE l.library_id=?
  `).all(libraryId);
  const stats = new Map();
  for (const row of rows) {
    const author = cleanText(row.preferred_local_author || row.author || '');
    const names = authorFacetNames(author);
    for (const dir of ancestorDirs(row.relative_path)) {
      if (!stats.has(dir)) stats.set(dir, { total: 0, known: 0, authors: new Map() });
      const st = stats.get(dir); st.total++;
      if (names.length) st.known++;
      for (const n of names) st.authors.set(n, (st.authors.get(n) || 0) + 1);
    }
  }

  db.prepare('DELETE FROM directory_roles WHERE library_id=? AND source=?').run(libraryId, 'auto-evidence');
  const up = db.prepare(`
    INSERT INTO directory_roles(library_id,relative_dir,role,subject,confidence,source,evidence_json)
    VALUES(?,?,?,?,?,?,?)
    ON CONFLICT(library_id,relative_dir) DO UPDATE SET role=excluded.role,subject=excluded.subject,confidence=excluded.confidence,source=excluded.source,evidence_json=excluded.evidence_json,updated_at=CURRENT_TIMESTAMP
  `);
  for (const [dir, st] of stats) {
    const base = path.basename(dir);
    let role = directoryRoleForName(base);
    let subject = '';
    let confidence = role ? 0.98 : 0;
    if (!role) {
      const exact = st.authors.get(base) || 0;
      const knownRatio = st.known ? exact / st.known : 0;
      if (exact >= 2 && knownRatio >= 0.72) {
        role = 'author'; subject = base; confidence = Math.min(0.99, 0.78 + exact * 0.025);
      } else {
        role = 'unknown'; confidence = 0.25;
      }
    }
    up.run(libraryId, dir, role, subject, confidence, 'auto-evidence', JSON.stringify({ total: st.total, knownAuthorBooks: st.known, authorMatches: st.authors.get(base) || 0 }));
  }

  // 修复旧版本曾把“刊物杂志汇编/通史/清史”等目录误当作者的情况。
  const bad = db.prepare(`
    SELECT f.hash,f.author,f.metadata_source,MIN(l.relative_path) relative_path
    FROM files f JOIN locations l ON l.hash=f.hash
    WHERE l.library_id=? AND f.metadata_source='filename+parent' AND f.author<>''
    GROUP BY f.hash
  `).all(libraryId);
  for (const row of bad) {
    const parent = normalizeRelKey(path.dirname(row.relative_path));
    const role = db.prepare('SELECT role FROM directory_roles WHERE library_id=? AND relative_dir=?').get(libraryId, parent)?.role;
    if (role && role !== 'author' && path.basename(parent) === cleanText(row.author)) {
      db.prepare(`UPDATE files SET author='',metadata_source='filename',updated_at=CURRENT_TIMESTAMP WHERE hash=? AND metadata_source='filename+parent'`).run(row.hash);
    }
  }

  // 对缺少作者的书，使用“最近的、已经证实为 author 的祖先目录”作为辅助证据。
  const missing = db.prepare(`
    SELECT l.hash,MIN(l.relative_path) relative_path,MAX(COALESCE(NULLIF(p.preferred_local_author,''),f.author,'')) current_author
    FROM locations l JOIN files f ON f.hash=l.hash
    LEFT JOIN book_local_profile p ON p.library_id=l.library_id AND p.hash=l.hash
    WHERE l.library_id=? GROUP BY l.hash
  `).all(libraryId);
  for (const row of missing) {
    if (cleanText(row.current_author)) continue;
    const dirs = ancestorDirs(row.relative_path).reverse();
    let inferred = '';
    for (const dir of dirs) {
      const rr = db.prepare(`SELECT role,subject FROM directory_roles WHERE library_id=? AND relative_dir=?`).get(libraryId, dir);
      if (rr?.role === 'author' && cleanText(rr.subject)) { inferred = cleanText(rr.subject); break; }
    }
    if (inferred) {
      ensureLocalProfileRow(db, libraryId, row.hash);
      db.prepare(`UPDATE book_local_profile SET preferred_local_author=?,updated_at=CURRENT_TIMESTAMP WHERE library_id=? AND hash=? AND COALESCE(preferred_local_author,'')=''`).run(inferred, libraryId, row.hash);
    }
  }
}

function xmlText(v) {
  if (v == null) return '';
  if (Array.isArray(v)) return xmlText(v[0]);
  if (typeof v === 'object') {
    if ('#text' in v) return cleanText(v['#text']);
    if ('_text' in v) return cleanText(v._text);
    return '';
  }
  return cleanText(v);
}

async function readEpubMetadata(filePath) {
  try {
    const zip = new AdmZip(filePath);
    const parser = new XMLParser({
      ignoreAttributes: false,
      attributeNamePrefix: '',
      removeNSPrefix: false,
      parseTagValue: false,
      trimValues: true,
    });

    const containerEntry = zip.getEntry('META-INF/container.xml');
    if (!containerEntry) return null;
    const container = parser.parse(containerEntry.getData().toString('utf8'));
    let rootfile = container?.container?.rootfiles?.rootfile;
    if (Array.isArray(rootfile)) rootfile = rootfile[0];
    const opfPath = rootfile?.['full-path'];
    if (!opfPath) return null;
    const opfEntry = zip.getEntry(opfPath);
    if (!opfEntry) return null;
    const opf = parser.parse(opfEntry.getData().toString('utf8'));
    const pkg = opf.package || opf['opf:package'];
    const meta = pkg?.metadata || pkg?.['opf:metadata'];
    if (!meta) return null;

    const title = xmlText(meta['dc:title'] || meta.title);
    let creator = meta['dc:creator'] || meta.creator;
    if (Array.isArray(creator)) creator = creator.map(xmlText).filter(Boolean).join(' & ');
    else creator = xmlText(creator);

    const publisher = xmlText(meta['dc:publisher'] || meta.publisher);
    const identifiers = meta['dc:identifier'] || meta.identifier;
    const list = Array.isArray(identifiers) ? identifiers : [identifiers].filter(Boolean);
    let isbn = '';
    for (const id of list) {
      const raw = xmlText(id);
      const match = raw.replace(/[-\s]/g, '').match(/(?:97[89])?\d{9}[\dXx]/);
      if (match) {
        isbn = match[0].toUpperCase();
        break;
      }
    }

    if (!title && !creator && !isbn) return null;
    return {
      title,
      author: creator,
      isbn,
      publisher,
      series: '',
      volume: '',
      source: 'epub-metadata',
      confidence: title && creator ? 0.99 : title ? 0.93 : 0.78,
    };
  } catch {
    return null;
  }
}

function isRecoverablePdfLibWarning(args) {
  const text = args.map(v => {
    try { return typeof v === 'string' ? v : String(v); } catch { return ''; }
  }).join(' ');
  return /Trying to parse invalid object|Invalid object ref:/i.test(text);
}

async function loadPdfQuietly(bytes) {
  // pdf-lib 在遇到部分“结构不规范但仍可读取”的扫描 PDF 时，会把恢复信息
  // 直接打印到 console.warn。它们不是扫描失败，却会把终端刷屏。
  // 扫描当前是串行的，因此可以在这一小段解析期间安全地过滤这两类已知警告。
  const originalWarn = console.warn;
  console.warn = (...args) => {
    if (!isRecoverablePdfLibWarning(args)) originalWarn(...args);
  };
  try {
    return await PDFDocument.load(bytes, {
      ignoreEncryption: true,
      updateMetadata: false,
      throwOnInvalidObject: false,
    });
  } finally {
    console.warn = originalWarn;
  }
}

async function readPdfMetadata(filePath, size) {
  if (size > MAX_PDF_METADATA_BYTES) return null;
  try {
    const bytes = await fsp.readFile(filePath);
    const doc = await loadPdfQuietly(bytes);
    let title = cleanText(doc.getTitle?.() || '');
    let author = cleanText(doc.getAuthor?.() || '');
    if (looksLikeGarbagePdfMetadata(title)) title = '';
    if (looksLikeGarbagePdfMetadata(author)) author = '';
    if (!title && !author) return null;
    return {
      title,
      author,
      isbn: '',
      publisher: '',
      series: '',
      volume: '',
      source: 'pdf-metadata',
      confidence: title && author ? 0.96 : title ? 0.86 : 0.72,
    };
  } catch {
    // PDF 元数据解析失败不影响入库：文件仍然会按 SHA-256 建档，
    // 书名/作者自动回退到文件名和父目录识别。
    return null;
  }
}

function mergeMetadata(primary, fallback) {
  if (!primary) return fallback;
  const out = { ...fallback, ...primary };
  for (const key of ['title', 'author', 'isbn', 'publisher', 'series', 'volume']) {
    if (!cleanText(out[key])) out[key] = fallback[key] || '';
  }
  out.confidence = Math.max(primary.confidence || 0, fallback.confidence || 0);
  out.source = primary.source || fallback.source;
  return out;
}

async function lookupOpenLibrary(meta) {
  try {
    // ISBN 可靠性最高。
    if (meta.isbn) {
      const url = `https://openlibrary.org/isbn/${encodeURIComponent(meta.isbn)}.json`;
      const r = await fetch(url, { signal: AbortSignal.timeout(5000) });
      if (r.ok) {
        const data = await r.json();
        let authors = [];
        if (Array.isArray(data.authors)) {
          authors = await Promise.all(data.authors.slice(0, 4).map(async a => {
            if (!a?.key) return '';
            try {
              const rr = await fetch(`https://openlibrary.org${a.key}.json`, { signal: AbortSignal.timeout(3500) });
              if (!rr.ok) return '';
              return cleanText((await rr.json()).name || '');
            } catch { return ''; }
          }));
        }
        const title = cleanText(data.title || '');
        if (title) {
          return {
            ...meta,
            title,
            author: authors.filter(Boolean).join(' & ') || meta.author,
            publisher: Array.isArray(data.publishers) ? cleanText(data.publishers[0]) : meta.publisher,
            source: 'openlibrary-isbn',
            confidence: 0.995,
          };
        }
      }
    }

    // 只在标题已有一定可信度时搜索，避免拿 01.pdf 之类去污染结果。
    if (!meta.title || meta.title.length < 2 || meta.confidence < 0.5) return null;
    const params = new URLSearchParams({ title: meta.title, limit: '5' });
    if (meta.author) params.set('author', meta.author);
    const r = await fetch(`https://openlibrary.org/search.json?${params}`, { signal: AbortSignal.timeout(5000) });
    if (!r.ok) return null;
    const data = await r.json();
    let best = null;
    let bestScore = 0;
    for (const doc of (data.docs || []).slice(0, 5)) {
      const titleScore = similarity(meta.title, doc.title || '');
      const candidateAuthor = Array.isArray(doc.author_name) ? doc.author_name.join(' & ') : '';
      const authorScore = meta.author && candidateAuthor ? similarity(meta.author, candidateAuthor) : 0.5;
      const score = titleScore * 0.8 + authorScore * 0.2;
      if (score > bestScore) {
        bestScore = score;
        best = { doc, candidateAuthor };
      }
    }
    if (!best || bestScore < 0.88) return null;
    return {
      ...meta,
      title: cleanText(best.doc.title || meta.title),
      author: cleanText(best.candidateAuthor || meta.author),
      isbn: meta.isbn || cleanText(Array.isArray(best.doc.isbn) ? best.doc.isbn[0] : ''),
      publisher: meta.publisher || cleanText(Array.isArray(best.doc.publisher) ? best.doc.publisher[0] : ''),
      source: 'openlibrary-search',
      confidence: Math.min(0.98, bestScore),
    };
  } catch {
    return null;
  }
}

async function detectMetadata(filePath, stat, { online = false } = {}) {
  const fallback = parseFilenameMetadata(filePath);
  const ext = path.extname(filePath).toLowerCase();
  let embedded = null;
  if (ext === '.epub') embedded = await readEpubMetadata(filePath);
  if (ext === '.pdf') embedded = await readPdfMetadata(filePath, stat.size);
  embedded = validateEmbeddedMetadata(embedded, fallback);
  let meta = mergeMetadata(embedded, fallback);
  meta.title = reconcileTitleWithFilename(meta.title, fallback.title);

  if (online && (meta.confidence < 0.8 || meta.isbn)) {
    const remote = await lookupOpenLibrary(meta);
    if (remote && remote.confidence >= meta.confidence) meta = remote;
  }
  return meta;
}

async function sha256(filePath, { totalBytes = 0, onProgress = null } = {}) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash(HASH_ALGO);
    const stream = fs.createReadStream(filePath, { highWaterMark: 4 * 1024 * 1024 });
    let readBytes = 0;
    stream.on('error', reject);
    stream.on('data', chunk => {
      hash.update(chunk);
      readBytes += chunk.length;
      if (onProgress) onProgress(readBytes, totalBytes);
    });
    stream.on('end', () => resolve(hash.digest('hex')));
  });
}

async function ensureDir(dir) {
  await fsp.mkdir(dir, { recursive: true });
}

function shouldIgnoreName(name) {
  if (!name) return true;
  if (name.startsWith('._')) return true;
  if (IGNORE_FILES.has(name)) return true;
  if (name === '.git' || name === 'node_modules') return true;
  return false;
}

async function* walkBooks(root) {
  const stack = [root];
  while (stack.length) {
    const dir = stack.pop();
    let entries;
    try {
      entries = await fsp.readdir(dir, { withFileTypes: true });
    } catch (error) {
      console.warn(`⚠ 无法读取目录：${dir} (${error.message})`);
      continue;
    }
    for (const entry of entries) {
      if (shouldIgnoreName(entry.name)) continue;
      const full = path.join(dir, entry.name);
      if (entry.isSymbolicLink()) continue;
      if (entry.isDirectory()) {
        stack.push(full);
        continue;
      }
      if (!entry.isFile()) continue;
      const ext = path.extname(entry.name).toLowerCase();
      if (!BOOK_EXTENSIONS.has(ext)) continue;
      yield full;
    }
  }
}


async function collectBookFiles(root, { silent = false, stageTotal = 2 } = {}) {
  const files = [];
  let last = 0;
  if (!silent) process.stdout.write(`  [1/${stageTotal}] 正在建立目录索引…`);
  for await (const filePath of walkBooks(root)) {
    files.push(filePath);
    if (!silent && process.stdout.isTTY && Date.now() - last > 90) {
      last = Date.now();
      process.stdout.write(`\r\x1b[2K  [1/${stageTotal}] 正在建立目录索引… 已发现 ${files.length} 个电子书文件`);
    }
  }
  if (!silent) {
    if (process.stdout.isTTY) process.stdout.write('\r\x1b[2K');
    console.log(`  [1/${stageTotal}] ✓ 目录索引完成：${files.length} 个电子书文件`);
  }
  return files;
}

function openDatabase() {
  fs.mkdirSync(APP_DIR, { recursive: true });
  const dbExisted = fs.existsSync(DB_PATH) && fs.statSync(DB_PATH).size > 0;
  const db = new DatabaseSync(DB_PATH);
  db.exec('PRAGMA journal_mode = WAL;');
  db.exec('PRAGMA synchronous = NORMAL;');
  db.exec('PRAGMA foreign_keys = ON;');

  // 数据库 schema 升级前做一次 SQLite 一致性快照。
  // 使用 VACUUM INTO 而不是直接复制 library.db，这样 WAL 中尚未 checkpoint 的数据也会进入备份。
  const schemaBefore = Number(db.prepare('PRAGMA user_version').get()?.user_version || 0);
  if (dbExisted && schemaBefore < DB_SCHEMA_VERSION) {
    const backupDir = path.join(APP_DIR, 'backups');
    fs.mkdirSync(backupDir, { recursive: true });
    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\..*$/, '').replace('T', '-');
    const backupPath = path.join(backupDir, `library-before-schema${DB_SCHEMA_VERSION}-${stamp}.db`);
    const sqlPath = backupPath.replace(/'/g, "''");
    try {
      db.exec(`VACUUM INTO '${sqlPath}'`);
      if (process.env.SHUFANG_VERBOSE === '1') console.log(`   数据库升级备份：${backupPath}`);
    } catch (error) {
      db.close();
      throw new Error(`数据库升级前备份失败，为保护书目数据已停止：${error.message}`);
    }
  }

  db.exec(`
    CREATE TABLE IF NOT EXISTS libraries (
      id INTEGER PRIMARY KEY,
      root TEXT NOT NULL UNIQUE,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      scanned_at TEXT
    );

    CREATE TABLE IF NOT EXISTS files (
      hash TEXT PRIMARY KEY,
      size INTEGER NOT NULL,
      ext TEXT,
      title TEXT,
      author TEXT,
      isbn TEXT,
      publisher TEXT,
      series TEXT,
      volume TEXT,
      metadata_source TEXT,
      confidence REAL NOT NULL DEFAULT 0,
      metadata_version INTEGER NOT NULL DEFAULT 1,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS locations (
      id INTEGER PRIMARY KEY,
      library_id INTEGER NOT NULL,
      hash TEXT NOT NULL,
      relative_path TEXT NOT NULL,
      absolute_path TEXT NOT NULL,
      size INTEGER NOT NULL,
      mtime_ms REAL NOT NULL,
      file_dev TEXT,
      file_ino TEXT,
      last_seen_scan TEXT NOT NULL,
      UNIQUE(library_id, relative_path),
      FOREIGN KEY(library_id) REFERENCES libraries(id) ON DELETE CASCADE,
      FOREIGN KEY(hash) REFERENCES files(hash) ON DELETE CASCADE
    );

    CREATE TABLE IF NOT EXISTS book_local_profile (
      library_id INTEGER NOT NULL,
      hash TEXT NOT NULL,
      current_relative_path TEXT,
      current_filename TEXT,
      original_filename TEXT,
      filename_title TEXT,
      filename_author TEXT,
      preferred_local_title TEXT,
      preferred_local_author TEXT,
      set_info TEXT,
      edition_info TEXT,
      rename_status TEXT NOT NULL DEFAULT 'none',
      rename_note TEXT,
      rename_source TEXT,
      evidence_json TEXT,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      PRIMARY KEY(library_id,hash),
      FOREIGN KEY(library_id) REFERENCES libraries(id) ON DELETE CASCADE,
      FOREIGN KEY(hash) REFERENCES files(hash) ON DELETE CASCADE
    );

    CREATE TABLE IF NOT EXISTS file_name_history (
      id INTEGER PRIMARY KEY,
      library_id INTEGER NOT NULL,
      hash TEXT NOT NULL,
      relative_path TEXT,
      filename TEXT NOT NULL,
      source TEXT NOT NULL,
      detail_json TEXT,
      observed_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(library_id,hash,relative_path,filename,source)
    );

    CREATE TABLE IF NOT EXISTS rename_events (
      id INTEGER PRIMARY KEY,
      library_id INTEGER NOT NULL,
      hash TEXT,
      source_file TEXT NOT NULL,
      old_path TEXT,
      new_path TEXT,
      old_name TEXT,
      new_name TEXT,
      status TEXT,
      note TEXT,
      raw_json TEXT,
      imported_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(library_id,source_file,old_path,new_path)
    );

    CREATE TABLE IF NOT EXISTS directory_roles (
      library_id INTEGER NOT NULL,
      relative_dir TEXT NOT NULL,
      role TEXT NOT NULL DEFAULT 'unknown',
      subject TEXT,
      confidence REAL NOT NULL DEFAULT 0,
      source TEXT,
      evidence_json TEXT,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      PRIMARY KEY(library_id,relative_dir)
    );

    CREATE TABLE IF NOT EXISTS reading_progress (
      library_id INTEGER NOT NULL,
      hash TEXT NOT NULL,
      format TEXT,
      progress REAL NOT NULL DEFAULT 0,
      locator TEXT,
      page INTEGER,
      total_pages INTEGER,
      reading_seconds INTEGER NOT NULL DEFAULT 0,
      started_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      last_read_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      completed_at TEXT,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      PRIMARY KEY(library_id,hash),
      FOREIGN KEY(library_id) REFERENCES libraries(id) ON DELETE CASCADE,
      FOREIGN KEY(hash) REFERENCES files(hash) ON DELETE CASCADE
    );

    CREATE TABLE IF NOT EXISTS reader_annotations (
      id TEXT PRIMARY KEY,
      library_id INTEGER NOT NULL,
      hash TEXT NOT NULL,
      format TEXT NOT NULL,
      scope TEXT NOT NULL DEFAULT '',
      start_offset INTEGER NOT NULL,
      end_offset INTEGER NOT NULL,
      quote TEXT NOT NULL DEFAULT '',
      progress REAL NOT NULL DEFAULT 0,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(library_id,hash,format,scope,start_offset,end_offset),
      FOREIGN KEY(library_id) REFERENCES libraries(id) ON DELETE CASCADE,
      FOREIGN KEY(hash) REFERENCES files(hash) ON DELETE CASCADE
    );

    CREATE INDEX IF NOT EXISTS idx_locations_hash ON locations(hash);
    CREATE INDEX IF NOT EXISTS idx_locations_library ON locations(library_id);
    CREATE INDEX IF NOT EXISTS idx_files_title ON files(title);
    CREATE INDEX IF NOT EXISTS idx_files_author ON files(author);
    CREATE INDEX IF NOT EXISTS idx_local_profile_hash ON book_local_profile(hash);
    CREATE INDEX IF NOT EXISTS idx_rename_events_hash ON rename_events(hash);
    CREATE INDEX IF NOT EXISTS idx_reading_progress_recent ON reading_progress(library_id,last_read_at DESC);
    CREATE INDEX IF NOT EXISTS idx_reading_progress_active ON reading_progress(library_id,progress);
    CREATE INDEX IF NOT EXISTS idx_reader_annotations_lookup ON reader_annotations(library_id,hash,format,scope,start_offset);
  `);

  const fileColumns = db.prepare('PRAGMA table_info(files)').all().map(r => r.name);
  if (!fileColumns.includes('metadata_version')) {
    db.exec('ALTER TABLE files ADD COLUMN metadata_version INTEGER NOT NULL DEFAULT 1;');
  }
  const locationColumns = db.prepare('PRAGMA table_info(locations)').all().map(r => r.name);
  if (!locationColumns.includes('file_dev')) db.exec('ALTER TABLE locations ADD COLUMN file_dev TEXT;');
  if (!locationColumns.includes('file_ino')) db.exec('ALTER TABLE locations ADD COLUMN file_ino TEXT;');
  db.exec('CREATE INDEX IF NOT EXISTS idx_locations_file_identity ON locations(library_id,file_dev,file_ino);');
  db.exec(`PRAGMA user_version = ${DB_SCHEMA_VERSION};`);
  fs.mkdirSync(COVERS_DIR, { recursive: true });
  return db;
}

function getOrCreateLibrary(db, root) {
  const normalized = normalizePath(root);
  let row = db.prepare('SELECT * FROM libraries WHERE root = ?').get(normalized);
  if (!row) {
    db.prepare('INSERT INTO libraries(root) VALUES (?)').run(normalized);
    row = db.prepare('SELECT * FROM libraries WHERE root = ?').get(normalized);
  }
  return row;
}

function upsertFile(db, hash, size, ext, meta, { force = false } = {}) {
  const old = db.prepare('SELECT * FROM files WHERE hash = ?').get(hash);
  if (!old) {
    db.prepare(`
      INSERT INTO files(hash,size,ext,title,author,isbn,publisher,series,volume,metadata_source,confidence,metadata_version)
      VALUES(?,?,?,?,?,?,?,?,?,?,?,?)
    `).run(
      hash, size, ext, meta.title || '', meta.author || '', meta.isbn || '',
      meta.publisher || '', meta.series || '', meta.volume || '',
      meta.source || '', Number(meta.confidence || 0), METADATA_VERSION
    );
    return;
  }

  if (force || Number(meta.confidence || 0) > Number(old.confidence || 0) + 0.01) {
    db.prepare(`
      UPDATE files SET title=?,author=?,isbn=?,publisher=?,series=?,volume=?,metadata_source=?,confidence=?,metadata_version=?,updated_at=CURRENT_TIMESTAMP
      WHERE hash=?
    `).run(
      meta.title || old.title || '', meta.author || old.author || '', meta.isbn || old.isbn || '',
      meta.publisher || old.publisher || '', meta.series || old.series || '', meta.volume || old.volume || '',
      meta.source || old.metadata_source || '', Number(meta.confidence || old.confidence || 0), METADATA_VERSION, hash
    );
  } else if (Number(old.metadata_version || 0) < METADATA_VERSION) {
    db.prepare('UPDATE files SET metadata_version=? WHERE hash=?').run(METADATA_VERSION, hash);
  }
}

function cachedMetadataNeedsRepair(filePath, row) {
  if (!row) return true;
  // 历史数据库中已经确认/保存的规范书目属于受保护元数据。即使未来本地解析规则升级，
  // 也不能在一次普通扫描中被文件名/PDF 内嵌元数据重新覆盖。
  if (/^(?:enrich:|manual-enrichment)/i.test(String(row.metadata_source || ''))) return false;
  if (Number(row.metadata_version || 0) >= METADATA_VERSION) return false;
  if (looksLikeMojibake(row.title || '') || looksLikeMojibake(row.author || '')) return true;

  // v6：清理 EPUB/PDF 元数据里夹带的套装说明和宣传文案。
  // 例如“中国文化通史【北师大出品！一部……】”应显示为“中国文化通史”。
  const cleanedCachedTitle = cleanCanonicalTitle(row.title || '');
  if (cleanedCachedTitle && cleanedCachedTitle !== cleanText(row.title || '')) return true;
  const v6Fallback = parseFilenameMetadata(filePath);
  if (v6Fallback?.title && row.title) {
    const a = normalizeForCompare(row.title);
    const b = normalizeForCompare(v6Fallback.title);
    if (a && b && a.includes(b) && a.length >= b.length + 4 && a.length > b.length * 1.18) return true;
  }

  // v4/v5 修复：旧解析器会把【图灵新知】这类丛书标签，或
  // [中国现代文学史全讲]这类课程/栏目标签误当成实际书名。
  // 只定向重解析这些旧缓存，不需要重算 SHA-256。
  if (filenameHasLeadingSeriesLabel(filePath)) return true;

  // v9：强制重放“《老子》通识.epub → 老子”修复。v0.4.0 曾提前写入 v8，导致旧错项可能被版本短路。
  // 只要当前文件名存在“《主标题》续接标题”，而缓存只剩书名号内部标题，就重解析。
  const v8Stem = cleanFileStem(filePath);
  const v8Quoted = v8Stem.match(/^《([^》]+)》(.+)$/u);
  if (v8Quoted && cleanText(v8Quoted[2])) {
    const cachedNorm = normalizeForCompare(row.title || '');
    if (cachedNorm && cachedNorm === normalizeForCompare(v8Quoted[1])) return true;
  }

  if (String(row.metadata_source || '').startsWith('pdf-metadata')) {
    const fallback = parseFilenameMetadata(filePath);
    if (embeddedFieldIsWorse(row.title || '', fallback.title || '')) return true;
    if (embeddedTitleConflictsWithFilename(row.title || '', fallback)) return true;
    if (row.author && fallback.author && embeddedFieldIsWorse(row.author, fallback.author)) return true;
  }
  return false;
}


async function statBookFile(filePath) {
  // Windows/NTFS 下 dev + ino 对应稳定的文件系统身份；同一磁盘内改名/移动不会变化。
  // 这样路径变化后无需重新读取整本书计算 SHA-256。
  try {
    const st = await fsp.stat(filePath, { bigint: true });
    return {
      size: Number(st.size),
      mtimeMs: Number(st.mtimeMs),
      fileDev: st.dev != null ? String(st.dev) : '',
      fileIno: st.ino != null ? String(st.ino) : '',
    };
  } catch {
    const st = await fsp.stat(filePath);
    return {
      size: Number(st.size),
      mtimeMs: Number(st.mtimeMs),
      fileDev: st.dev != null ? String(st.dev) : '',
      fileIno: st.ino != null ? String(st.ino) : '',
    };
  }
}

function sameMtime(a, b) {
  return Math.abs(Number(a || 0) - Number(b || 0)) < 1;
}

async function scanLibrary(db, root, { online = false, silent = false, label = '书库', stageTotal = 2 } = {}) {
  root = normalizePath(root);
  const library = getOrCreateLibrary(db, root);
  const scanId = new Date().toISOString();
  const cachedStmt = db.prepare(`
    SELECT hash,size,mtime_ms,file_dev,file_ino FROM locations
