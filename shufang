#!/usr/bin/env node
'use strict';

/**
 * 书房 v0.7.0
 *
 * 用法：
 *   node shufang "D:\\Books"
 *   node shufang "D:\\Books" 联网
 *   node shufang "D:\\BooksA" 更新 "E:\\BooksB"
 *
 * 设计原则：
 *   1. SHA-256 = 文件身份；路径/文件名不作为唯一性判断。
 *   2. 缓存放在 ~/.shufang/library.db，不污染电子书目录。
 *   3. 书目元数据与本地文件名分层保存；目录角色必须有证据，禁止仅凭“像人名”猜作者。
 *   4. 更新模式：B - A，复制到 A/更新_时间/，保留 B 相对目录。
 */

