  };
  const response = await noteBridgeFetch('/api/integrations/shufang/excerpt', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }, 12000);
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || `写入笔记失败：HTTP ${response.status}`);
