}
function sanitizeEpubDocument(data) {
  let html = decodeEpubDocumentBuffer(data);
  // EPUB 内容作为“文档”阅读，不允许书内脚本在书房同源页面中执行。
  // 在服务端移除脚本和事件属性，比仅依赖 iframe sandbox 更稳定，也不会让某些旧 EPUB 的坏 JS
  // 在控制台制造 SyntaxError / sandbox 警告。
  html = html
    .replace(/<script\b[\s\S]*?<\/script\s*>/gi, '')
    .replace(/<script\b[^>]*\/\s*>/gi, '')
    .replace(/<iframe\b[\s\S]*?<\/iframe\s*>/gi, '')
    .replace(/<object\b[\s\S]*?<\/object\s*>/gi, '')
    .replace(/<embed\b[^>]*>/gi, '')
    .replace(/\s+on[a-z0-9:_-]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
    .replace(/\s+(href|src)\s*=\s*(["'])\s*javascript:[\s\S]*?\2/gi, (all, name, quote) => ` ${name}=${quote}#${quote}`)
