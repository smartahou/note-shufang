    if(!ncxItem) ncxItem=manifestItems.find(i=>/ncx/i.test(String(i?.['media-type']||'')));
    if(ncxItem?.href){const ncxEntry=normalizeEpubEntry(opfPath,ncxItem.href); const e=zip.getEntry(ncxEntry); if(e) toc=parseEpubNcx(e.getData().toString('utf8'),ncxEntry,spineIndexByEntry);}
