async function noteBridgeFetch(pathname, options = {}, timeoutMs = 4000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const response = await fetch(`${NOTE_BRIDGE_ORIGIN}${pathname}`, { ...options, signal: controller.signal });
    return response;
  } catch (error) {
    const message = error?.name === 'AbortError' ? '连接笔记服务超时' : (error?.message || String(error));
    throw new Error(`笔记服务未启动或无法连接（${NOTE_BRIDGE_ORIGIN}）。请另开终端执行 node note。${message ? `\n${message}` : ''}`);
  } finally {
    clearTimeout(timer);
  }
}

async function listBridgeNotes(query = '') {
  const suffix = query ? `?q=${encodeURIComponent(query)}` : '';
  const response = await noteBridgeFetch(`/api/notes${suffix}`, { headers: { Accept: 'application/json' } });
  if (!response.ok) throw new Error(`读取笔记列表失败：HTTP ${response.status}`);
  const notes = await response.json();
  return Array.isArray(notes) ? notes.filter(note => !note.locked) : [];
}

async function sendCaptureToNote({ buffer, fileName, noteId, newTitle, item, page, totalPages, crop, mode, shufangOrigin }) {
  const form = new FormData();
  form.append('image', new Blob([buffer], { type: 'image/png' }), fileName);
  form.append('noteId', String(noteId || ''));
  form.append('newTitle', String(newTitle || ''));
  form.append('bookHash', String(item.hash || ''));
  form.append('bookTitle', String(item.title || path.basename(item.absolute_path)));
  form.append('relativePath', String(item.relative_path || ''));
  form.append('page', String(page));
  form.append('totalPages', String(totalPages || 0));
  form.append('crop', String(crop || ''));
  form.append('mode', mode === 'crop' ? 'crop' : 'page');
  form.append('shufangOrigin', shufangOrigin);

  const response = await noteBridgeFetch('/api/integrations/shufang/capture', { method: 'POST', body: form }, 20000);
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || `写入笔记失败：HTTP ${response.status}`);
  return data;
}

async function sendExcerptToNote({ noteId, newTitle, item, format, scope, start, end, quote, progress, chapterIndex, chapterTotal, chapterTitle, shufangOrigin }) {
  const payload = {
    noteId: String(noteId || ''),
    newTitle: String(newTitle || ''),
    bookHash: String(item.hash || ''),
    bookTitle: String(item.title || path.basename(item.absolute_path)),
    relativePath: String(item.relative_path || ''),
    format: String(format || '').toLowerCase(),
    scope: String(scope || ''),
    start: Math.max(0, Math.floor(Number(start) || 0)),
    end: Math.max(0, Math.floor(Number(end) || 0)),
    quote: String(quote || ''),
    progress: Math.max(0, Math.min(1, Number(progress) || 0)),
    chapterIndex: Number.isFinite(Number(chapterIndex)) ? Math.max(-1, Math.floor(Number(chapterIndex))) : -1,
    chapterTotal: Math.max(0, Math.floor(Number(chapterTotal) || 0)),
