function normalizeReadingProgress(row) {
  if (!row) return {
    progress: 0, locator: '', page: null, total_pages: null,
    reading_seconds: 0, started_at: null, last_read_at: null, completed_at: null,
  };
  return {
    progress: Math.max(0, Math.min(1, Number(row.progress || 0))),
    locator: String(row.locator || ''),
    page: row.page == null ? null : Number(row.page),
    total_pages: row.total_pages == null ? null : Number(row.total_pages),
    reading_seconds: Math.max(0, Number(row.reading_seconds || 0)),
    started_at: row.started_at || null,
    last_read_at: row.last_read_at || null,
    completed_at: row.completed_at || null,
  };
}

function getReadingProgress(db, libraryId, hash) {
  const row = db.prepare(`
    SELECT progress,locator,page,total_pages,reading_seconds,started_at,last_read_at,completed_at
    FROM reading_progress WHERE library_id=? AND hash=?
  `).get(libraryId, hash);
  return normalizeReadingProgress(row);
}

function saveReadingProgress(db, libraryId, hash, ext, input = {}) {
  const progress = Math.max(0, Math.min(1, Number(input.progress || 0)));
  const locator = typeof input.locator === 'string' ? input.locator.slice(0, 8192) : '';
  const pageRaw = Number(input.page);
  const totalRaw = Number(input.total_pages);
  const page = Number.isFinite(pageRaw) && pageRaw > 0 ? Math.floor(pageRaw) : null;
  const totalPages = Number.isFinite(totalRaw) && totalRaw > 0 ? Math.floor(totalRaw) : null;
  const secondsRaw = Number(input.seconds_delta || 0);
  const secondsDelta = Number.isFinite(secondsRaw) ? Math.max(0, Math.min(3600, Math.floor(secondsRaw))) : 0;
  const format = String(ext || '').toLowerCase();

  db.prepare(`
    INSERT INTO reading_progress(
      library_id,hash,format,progress,locator,page,total_pages,reading_seconds,
      started_at,last_read_at,completed_at,updated_at
    ) VALUES(?,?,?,?,?,?,?, ?, CURRENT_TIMESTAMP,CURRENT_TIMESTAMP,
      CASE WHEN ?>=0.995 THEN CURRENT_TIMESTAMP ELSE NULL END,CURRENT_TIMESTAMP)
    ON CONFLICT(library_id,hash) DO UPDATE SET
      format=excluded.format,
      progress=excluded.progress,
      locator=CASE WHEN excluded.locator<>'' THEN excluded.locator ELSE reading_progress.locator END,
      page=COALESCE(excluded.page,reading_progress.page),
      total_pages=COALESCE(excluded.total_pages,reading_progress.total_pages),
      reading_seconds=reading_progress.reading_seconds+excluded.reading_seconds,
      last_read_at=CURRENT_TIMESTAMP,
      completed_at=CASE
        WHEN excluded.progress>=0.995 THEN COALESCE(reading_progress.completed_at,CURRENT_TIMESTAMP)
        WHEN excluded.progress<0.98 THEN NULL
        ELSE reading_progress.completed_at
      END,
      updated_at=CURRENT_TIMESTAMP
  `).run(libraryId, hash, format, progress, locator, page, totalPages, secondsDelta, progress);
  return getReadingProgress(db, libraryId, hash);
}


function normalizeAnnotationFormat(value, ext = '') {
  const raw = String(value || '').toLowerCase().replace(/^\./, '');
  const expected = String(ext || '').toLowerCase().replace(/^\./, '');
  if (!['txt', 'md', 'epub'].includes(raw)) return '';
  if (expected && raw !== expected) return '';
  return raw;
}

function annotationRow(row) {
  return {
    id: String(row.id),
    format: String(row.format || ''),
    scope: String(row.scope || ''),
    start: Number(row.start_offset || 0),
    end: Number(row.end_offset || 0),
    quote: String(row.quote || ''),
    progress: Math.max(0, Math.min(1, Number(row.progress || 0))),
    createdAt: row.created_at || null,
    updatedAt: row.updated_at || null,
  };
}

function listReaderAnnotations(db, libraryId, hash, format, scope) {
  return db.prepare(`
    SELECT id,format,scope,start_offset,end_offset,quote,progress,created_at,updated_at
    FROM reader_annotations
    WHERE library_id=? AND hash=? AND format=? AND scope=?
    ORDER BY start_offset,end_offset,created_at
  `).all(libraryId, hash, format, scope).map(annotationRow);
}

function createReaderAnnotation(db, libraryId, hash, format, input = {}) {
  const scope = String(input.scope || '').slice(0, 2048);
  const start = Math.max(0, Math.floor(Number(input.start) || 0));
  const end = Math.max(0, Math.floor(Number(input.end) || 0));
  const quote = String(input.quote || '').replace(/\r\n?/g, '\n').slice(0, 20000);
  const progress = Math.max(0, Math.min(1, Number(input.progress) || 0));
  if (end <= start || !quote.trim()) throw new Error('划线范围为空');
  if (end - start > 20000) throw new Error('单次划线内容过长');

  const exact = db.prepare(`
    SELECT id,format,scope,start_offset,end_offset,quote,progress,created_at,updated_at
    FROM reader_annotations
    WHERE library_id=? AND hash=? AND format=? AND scope=? AND start_offset=? AND end_offset=?
    LIMIT 1
  `).get(libraryId, hash, format, scope, start, end);
  if (exact) return annotationRow(exact);

  const overlap = db.prepare(`
    SELECT id FROM reader_annotations
    WHERE library_id=? AND hash=? AND format=? AND scope=?
      AND NOT(end_offset<=? OR start_offset>=?)
    LIMIT 1
  `).get(libraryId, hash, format, scope, start, end);
  if (overlap) {
    const error = new Error('该范围与已有划线重叠，请先取消原划线后再重新选择');
    error.statusCode = 409;
    throw error;
  }

  const id = crypto.randomUUID();
  db.prepare(`
    INSERT INTO reader_annotations(id,library_id,hash,format,scope,start_offset,end_offset,quote,progress)
    VALUES(?,?,?,?,?,?,?,?,?)
  `).run(id, libraryId, hash, format, scope, start, end, quote, progress);
  return annotationRow(db.prepare(`
    SELECT id,format,scope,start_offset,end_offset,quote,progress,created_at,updated_at
    FROM reader_annotations WHERE id=?
  `).get(id));
}

function deleteReaderAnnotation(db, libraryId, hash, id) {
  const result = db.prepare('DELETE FROM reader_annotations WHERE id=? AND library_id=? AND hash=?').run(String(id || ''), libraryId, hash);
  return Number(result?.changes || 0) > 0;
}

async function readRawBody(req, maxBytes = 32 * 1024 * 1024) {
  const chunks = [];
  let size = 0;
  for await (const chunk of req) {
    size += chunk.length;
    if (size > maxBytes) throw new Error('截图数据过大');
    chunks.push(chunk);
  }
  return Buffer.concat(chunks);
}

function normalizeCropParam(value = '') {
  const parts = String(value || '').split(',').map(Number);
  if (parts.length !== 4 || parts.some(v => !Number.isFinite(v))) return '';
  const [x, y, w, h] = parts;
  if (x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > 1.001 || y + h > 1.001) return '';
  return parts.map(v => Math.max(0, Math.min(1, v)).toFixed(6)).join(',');
}

async function readJsonBody(req, maxBytes = 65536) {
  const chunks = [];
  let size = 0;
  for await (const chunk of req) {
    size += chunk.length;
    if (size > maxBytes) throw new Error('Request body too large');
    chunks.push(chunk);
  }
  if (!chunks.length) return {};
  const text = Buffer.concat(chunks).toString('utf8');
  return text ? JSON.parse(text) : {};
}

function startServer(db, root, libraryId, port = DEFAULT_PORT) {
  const html = pageHtml(root);
  const server = http.createServer(async (req, res) => {
    try {
      const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
      if (url.pathname === '/') {
        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
        return res.end(html);
      }
      if (url.pathname === '/vendor/pdf.mjs' || url.pathname === '/vendor/pdf.worker.mjs') {
        const fileName = url.pathname.endsWith('pdf.worker.mjs') ? 'pdf.worker.mjs' : 'pdf.mjs';
        const vendorPath = path.join(__dirname, 'node_modules', 'pdfjs-dist', 'build', fileName);
        if (!fs.existsSync(vendorPath)) {
          res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
          return res.end('缺少 pdfjs-dist，请在书房目录执行 npm install');
        }
        const stat = await fsp.stat(vendorPath);
        res.writeHead(200, {
          'Content-Type': 'text/javascript; charset=utf-8',
          'Content-Length': stat.size,
          'Cache-Control': 'public, max-age=86400',
        });
        return fs.createReadStream(vendorPath).pipe(res);
      }
      if (url.pathname.startsWith('/vendor/pdfjs-assets/')) {
        const rel = decodeURIComponent(url.pathname.slice('/vendor/pdfjs-assets/'.length));
        const parts = rel.split('/').filter(Boolean);
        const allowedTop = new Set(['cmaps','standard_fonts','wasm']);
        if (parts.length < 2 || !allowedTop.has(parts[0]) || parts.some(x => x === '..' || x.includes('\\'))) { res.writeHead(404); return res.end(); }
        const pdfRoot = path.dirname(require.resolve('pdfjs-dist/package.json'));
        const base = path.resolve(pdfRoot, parts[0]);
        const assetPath = path.resolve(base, ...parts.slice(1));
        if (!(assetPath === base || assetPath.startsWith(base + path.sep)) || !fs.existsSync(assetPath) || !fs.statSync(assetPath).isFile()) { res.writeHead(404); return res.end(); }
        const stat = await fsp.stat(assetPath);
        const assetExt = path.extname(assetPath).toLowerCase();
        const mime = assetExt === '.wasm' ? 'application/wasm' : assetExt === '.ttf' ? 'font/ttf' : assetExt === '.otf' ? 'font/otf' : 'application/octet-stream';
        res.writeHead(200, { 'Content-Type': mime, 'Content-Length': stat.size, 'Cache-Control': 'public, max-age=86400' });
        return fs.createReadStream(assetPath).pipe(res);
      }
      if (req.method === 'POST' && url.pathname.startsWith('/api/cover-cache/')) {
        const hash = decodeURIComponent(url.pathname.slice('/api/cover-cache/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.pdf') { res.writeHead(404); return res.end(); }
        const chunks = [];
        let size = 0;
        for await (const chunk of req) {
          size += chunk.length;
          if (size > 4 * 1024 * 1024) { res.writeHead(413); return res.end('Cover too large'); }
          chunks.push(chunk);
        }
        const saved = await saveBrowserRenderedPdfCover(hash, Buffer.concat(chunks));
        if (!saved) { res.writeHead(400); return res.end('Invalid PNG'); }
        res.writeHead(204, { 'Cache-Control': 'no-store' });
        return res.end();
      }
      if (url.pathname === '/api/books') {
        const q = cleanText(url.searchParams.get('q') || '');
        const dir = cleanText(url.searchParams.get('dir') || '');
        const type = cleanText(url.searchParams.get('type') || '');
        const author = cleanText(url.searchParams.get('author') || '');
        const reading = cleanText(url.searchParams.get('reading') || '');
        const sort = cleanText(url.searchParams.get('sort') || 'directory');
        const books = queryBooks(db, libraryId, { q, dir, type, author, reading, sort });
        const stats = getStats(db, libraryId);
        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
        return res.end(JSON.stringify({ books, matched: books.length, stats }));
      }
      if (url.pathname === '/api/facets') {
        const facets = getFacets(db, libraryId);
        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
        return res.end(JSON.stringify(facets));
      }
      if (url.pathname === '/api/tree') {
        const tree = await buildActualDirectoryTree(root);
        res.writeHead(200, {
          'Content-Type': 'text/plain; charset=utf-8',
          'Cache-Control': 'no-store',
          'Content-Length': Buffer.byteLength(tree, 'utf8'),
        });
        return res.end(tree);
      }
      if (req.method === 'GET' && url.pathname === '/api/note-bridge/notes') {
        try {
          const notes = await listBridgeNotes(String(url.searchParams.get('q') || ''));
          const body = JSON.stringify(notes);
          res.writeHead(200, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        } catch (error) {
          const body = JSON.stringify({ error: error?.message || String(error) });
          res.writeHead(503, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        }
      }
      if (req.method === 'POST' && url.pathname.startsWith('/api/note-bridge/capture/')) {
        const rest = url.pathname.slice('/api/note-bridge/capture/'.length).split('/').filter(Boolean);
        if (rest.length !== 2) { res.writeHead(404); return res.end(); }
        const hash = decodeURIComponent(rest[0]);
        const pageNo = Number(rest[1]);
        if (!/^[a-f0-9]{64}$/i.test(hash) || !Number.isInteger(pageNo) || pageNo < 1) {
          const body=JSON.stringify({error:'截图来源无效'});res.writeHead(400,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body)});return res.end(body);
        }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.pdf' || !fs.existsSync(item.absolute_path)) {
          const body=JSON.stringify({error:'PDF 已不存在于当前书库'});res.writeHead(404,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body)});return res.end(body);
        }
        try {
          const buffer = await readRawBody(req);
          if (!buffer.length) throw new Error('截图为空');
          const pngSignature = Buffer.from([0x89,0x50,0x4e,0x47,0x0d,0x0a,0x1a,0x0a]);
          if (buffer.length < 8 || !buffer.subarray(0,8).equals(pngSignature)) throw new Error('截图不是有效的 PNG');
          const mode = url.searchParams.get('mode') === 'crop' ? 'crop' : 'page';
          const crop = mode === 'crop' ? normalizeCropParam(url.searchParams.get('crop') || '') : '';
          if (mode === 'crop' && !crop) throw new Error('框选区域信息无效');
          const totalPages = Math.max(0, Math.floor(Number(url.searchParams.get('totalPages')) || 0));
          const noteId = String(url.searchParams.get('noteId') || '').trim();
          const newTitle = String(url.searchParams.get('newTitle') || '').trim().slice(0,160);
          const result = await sendCaptureToNote({
            buffer,
            fileName: `${hash.slice(0,12)}-p${pageNo}-${mode}.png`,
            noteId,
            newTitle,
            item,
            page: pageNo,
            totalPages,
            crop,
            mode,
            shufangOrigin: SHUFANG_PUBLIC_ORIGIN || `http://127.0.0.1:${port}`,
          });
          const body = JSON.stringify({ ...result, noteUrl: result?.note?.id ? `${NOTE_PUBLIC_ORIGIN}/?note=${encodeURIComponent(result.note.id)}` : NOTE_PUBLIC_ORIGIN });
          res.writeHead(200, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        } catch (error) {
          const body = JSON.stringify({ error: error?.message || String(error) });
          res.writeHead(500, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        }
      }

      if (req.method === 'POST' && url.pathname.startsWith('/api/note-bridge/excerpt/')) {
        const hash = decodeURIComponent(url.pathname.slice('/api/note-bridge/excerpt/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) {
          const body=JSON.stringify({error:'摘录来源无效'});res.writeHead(400,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body)});return res.end(body);
        }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) {
          const body=JSON.stringify({error:'原书已不存在于当前书库'});res.writeHead(404,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body)});return res.end(body);
        }
        try {
          const input = await readJsonBody(req, 128 * 1024);
          const format = normalizeAnnotationFormat(input.format, item.ext);
          if (!format) throw new Error('当前格式不支持文本摘录');
          const start = Math.max(0, Math.floor(Number(input.start) || 0));
          const end = Math.max(0, Math.floor(Number(input.end) || 0));
          const quote = String(input.text || input.quote || '').replace(/\r\n?/g,'\n').slice(0,20000);
          if (end <= start || !quote.trim()) throw new Error('摘录内容为空');
          const result = await sendExcerptToNote({
            noteId: input.noteId,
            newTitle: input.newTitle,
            item,
            format,
            scope: input.scope,
            start,
            end,
            quote,
            progress: input.progress,
            chapterIndex: input.chapterIndex,
            chapterTotal: input.chapterTotal,
            chapterTitle: input.chapterTitle,
            shufangOrigin: SHUFANG_PUBLIC_ORIGIN || `http://127.0.0.1:${port}`,
          });
          const body = JSON.stringify({ ...result, noteUrl: result?.note?.id ? `${NOTE_PUBLIC_ORIGIN}/?note=${encodeURIComponent(result.note.id)}` : NOTE_PUBLIC_ORIGIN });
          res.writeHead(200, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        } catch (error) {
          const body=JSON.stringify({error:error?.message||String(error)});res.writeHead(Number(error?.statusCode)||500,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body),'Cache-Control':'no-store'});return res.end(body);
        }
      }
      if (url.pathname.startsWith('/api/annotations/')) {
        markReaderActivity(12000);
        const rest = url.pathname.slice('/api/annotations/'.length).split('/').filter(Boolean);
        const hash = decodeURIComponent(rest[0] || '');
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('File not found'); }
        const format = normalizeAnnotationFormat(url.searchParams.get('format') || (req.method === 'GET' ? '' : undefined), item.ext);
        if (req.method === 'GET') {
          const f = normalizeAnnotationFormat(url.searchParams.get('format'), item.ext);
          if (!f) { const body=JSON.stringify({error:'Unsupported annotation format'});res.writeHead(400,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body)});return res.end(body); }
          const scope = String(url.searchParams.get('scope') || '').slice(0,2048);
          const body = JSON.stringify(listReaderAnnotations(db, libraryId, hash, f, scope));
          res.writeHead(200, {'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body),'Cache-Control':'no-store'});return res.end(body);
        }
        if (req.method === 'POST' && rest.length === 1) {
          try {
            const input = await readJsonBody(req, 128 * 1024);
            const f = normalizeAnnotationFormat(input.format, item.ext);
            if (!f) throw new Error('当前格式不支持划线');
            const row = createReaderAnnotation(db, libraryId, hash, f, input);
            const body=JSON.stringify(row);res.writeHead(201,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body),'Cache-Control':'no-store'});return res.end(body);
          } catch (error) {
            const body=JSON.stringify({error:error?.message||String(error)});res.writeHead(Number(error?.statusCode)||400,{'Content-Type':'application/json; charset=utf-8','Content-Length':Buffer.byteLength(body),'Cache-Control':'no-store'});return res.end(body);
          }
        }
        if (req.method === 'DELETE' && rest.length === 2) {
          const deleted = deleteReaderAnnotation(db, libraryId, hash, decodeURIComponent(rest[1]));
          res.writeHead(deleted ? 204 : 404, {'Cache-Control':'no-store'});return res.end();
        }
        res.writeHead(405, { Allow: 'GET, POST, DELETE' }); return res.end();
      }

      if (req.method === 'GET' && url.pathname.startsWith('/api/pdf-info/')) {
        const hash = decodeURIComponent(url.pathname.slice('/api/pdf-info/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.pdf' || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('PDF not found'); }
        try {
          const info = await getPdfReaderInfo(item);
          const body = JSON.stringify(info);
          res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Content-Length': Buffer.byteLength(body), 'Cache-Control': 'no-store' });
          return res.end(body);
        } catch (error) {
          console.error(`PDF info failed: ${item.absolute_path}\n${errorText(error)}`);
          const body = `PDF 解析失败：${error?.message || error}`;
          res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8', 'Content-Length': Buffer.byteLength(body) });
          return res.end(body);
        }
      }
      if (req.method === 'GET' && url.pathname.startsWith('/api/pdf-page/')) {
        const rest = url.pathname.slice('/api/pdf-page/'.length).split('/').filter(Boolean);
        if (rest.length !== 2) { res.writeHead(404); return res.end(); }
        const hash = decodeURIComponent(rest[0]);
        const pageNo = Number(rest[1]);
        if (!/^[a-f0-9]{64}$/i.test(hash) || !Number.isInteger(pageNo) || pageNo < 1) { res.writeHead(400); return res.end('Bad PDF page request'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.pdf' || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('PDF not found'); }
        try {
          const rendered = await renderPdfReaderPage(item, pageNo, Number(url.searchParams.get('w') || 1100));
          res.writeHead(200, {
            'Content-Type': 'image/png',
            'Content-Length': rendered.size,
            'Cache-Control': 'private, max-age=31536000, immutable',
            'X-Shufang-Renderer': 'isolated-worker',
          });
          return fs.createReadStream(rendered.path).pipe(res);
        } catch (error) {
          console.error(`PDF page render failed: ${item.absolute_path} #${pageNo}\n${errorText(error)}`);
          const body = `PDF 第 ${pageNo} 页渲染失败：${error?.message || error}`;
          res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8', 'Content-Length': Buffer.byteLength(body), 'Cache-Control': 'no-store' });
          return res.end(body);
        }
      }
      if (req.method === 'GET' && url.pathname.startsWith('/api/epub-info/')) {
        markReaderActivity(16000);
        const hash = decodeURIComponent(url.pathname.slice('/api/epub-info/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.epub' || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('EPUB not found'); }
        try {
          const session = getEpubSession(item);
          const body = JSON.stringify({ spine: session.spine.map(x => ({ index:x.index, entry:x.entry, label:x.label })), toc: session.toc });
          res.writeHead(200, { 'Content-Type':'application/json; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        } catch (error) {
          console.error(`EPUB parse failed: ${item.absolute_path}\n${errorText(error)}`);
          const body = `EPUB 解析失败：${error?.message || error}`;
          res.writeHead(500, { 'Content-Type':'text/plain; charset=utf-8', 'Content-Length':Buffer.byteLength(body), 'Cache-Control':'no-store' });
          return res.end(body);
        }
      }
      if (req.method === 'GET' && url.pathname.startsWith('/epub/')) {
        markReaderActivity(10000);
        const rest = url.pathname.slice('/epub/'.length);
        const slash = rest.indexOf('/');
        if (slash <= 0) { res.writeHead(404); return res.end(); }
        const hash = decodeURIComponent(rest.slice(0, slash));
        let entryName = rest.slice(slash + 1).split('/').map(x => { try { return decodeURIComponent(x); } catch { return x; } }).join('/');
        entryName = path.posix.normalize(entryName).replace(/^\/+/, '');
        if (!/^[a-f0-9]{64}$/i.test(hash) || !entryName || entryName.startsWith('../') || entryName.includes('/../')) { res.writeHead(400); return res.end('Bad EPUB resource'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || String(item.ext || '').toLowerCase() !== '.epub' || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('EPUB not found'); }
        try {
          const session = getEpubSession(item); const entry = session.zip.getEntry(entryName);
          if (!entry || entry.isDirectory) { res.writeHead(404); return res.end('EPUB resource not found'); }
          let data = entry.getData(); const mime = epubResourceMime(entryName);
          const isDocument = /text\/html|application\/xhtml/i.test(mime);
          if (isDocument) data = sanitizeEpubDocument(data);
          const headers = {
            'Content-Type': mime,
            'Content-Length': data.length,
            'Cache-Control': 'private, max-age=3600',
            'Cross-Origin-Resource-Policy': 'same-origin',
            'X-Content-Type-Options': 'nosniff',
          };
          if (isDocument) headers['Content-Security-Policy'] = "default-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self'; script-src 'none'; object-src 'none'; frame-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none';";
          res.writeHead(200, headers); return res.end(data);
        } catch (error) {
          console.error(`EPUB resource failed: ${item.absolute_path} :: ${entryName}\n${errorText(error)}`);
          const body=`EPUB 资源读取失败：${error?.message || error}`; res.writeHead(500,{'Content-Type':'text/plain; charset=utf-8','Content-Length':Buffer.byteLength(body)}); return res.end(body);
        }
      }
      if (url.pathname.startsWith('/api/reading-progress/')) {
        markReaderActivity(15000);
        const hash = decodeURIComponent(url.pathname.slice('/api/reading-progress/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('File not found'); }
        if (req.method === 'GET') {
          const progress = getReadingProgress(db, libraryId, hash);
          res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
          return res.end(JSON.stringify(progress));
        }
        if (req.method === 'POST' || req.method === 'PUT') {
          let input;
          try { input = await readJsonBody(req); }
          catch (error) { res.writeHead(400, { 'Content-Type': 'text/plain; charset=utf-8' }); return res.end(error.message); }
          const progress = saveReadingProgress(db, libraryId, hash, item.ext, input);
          res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
          return res.end(JSON.stringify(progress));
        }
        res.writeHead(405, { Allow: 'GET, POST, PUT' }); return res.end();
      }
      if (url.pathname.startsWith('/reader/')) {
        markReaderActivity(18000);
        const hash = decodeURIComponent(url.pathname.slice('/reader/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) { res.writeHead(400); return res.end('Bad hash'); }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) { res.writeHead(404); return res.end('File not found'); }
        const progress = getReadingProgress(db, libraryId, hash);
        const reader = readerHtml(item, progress, {
          page: url.searchParams.get('page'),
          crop: url.searchParams.get('crop'),
          chapter: url.searchParams.get('chapter'),
          start: url.searchParams.get('start'),
          end: url.searchParams.get('end'),
          progress: url.searchParams.get('progress'),
          from: url.searchParams.get('from'),
        });
        res.writeHead(200, {
          'Content-Type': 'text/html; charset=utf-8',
          'Content-Length': Buffer.byteLength(reader, 'utf8'),
          'Cache-Control': 'no-store',
        });
        return res.end(reader);
      }
      if (url.pathname.startsWith('/cover/')) {
        const hash = decodeURIComponent(url.pathname.slice('/cover/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) {
          res.writeHead(400); return res.end('Bad hash');
        }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) {
          res.writeHead(404); return res.end();
        }
        const cover = findCachedCover(hash);
        if (!cover || !fs.existsSync(cover.path)) {
          // 封面缺失只返回占位；真正的提取/渲染由启动后的低优先级后台维护完成。
          res.writeHead(404, { 'Cache-Control': 'no-store' }); return res.end();
        }
        const stat = await fsp.stat(cover.path);
        res.writeHead(200, {
          'Content-Type': cover.mime,
          'Content-Length': stat.size,
          'Cache-Control': 'public, max-age=31536000, immutable',
        });
        return fs.createReadStream(cover.path).pipe(res);
      }
      if (url.pathname.startsWith('/book/')) {
        markReaderActivity(12000);
        const hash = decodeURIComponent(url.pathname.slice('/book/'.length));
        if (!/^[a-f0-9]{64}$/i.test(hash)) {
          res.writeHead(400); return res.end('Bad hash');
        }
        const item = findBookLocation(db, libraryId, hash);
        if (!item || !fs.existsSync(item.absolute_path)) {
          res.writeHead(404); return res.end('File not found');
        }
        const stat = await fsp.stat(item.absolute_path);
        const range = req.headers.range;
        const type = contentType(item.absolute_path);
        if (range) {
          const m = range.match(/bytes=(\d*)-(\d*)/);
          if (m) {
            let start, end;
            if (!m[1] && m[2]) {
              const suffixLength = Math.max(0, Number(m[2]) || 0);
              start = Math.max(0, stat.size - suffixLength); end = stat.size - 1;
            } else {
              start = m[1] ? Number(m[1]) : 0;
              end = m[2] ? Math.min(Number(m[2]), stat.size - 1) : stat.size - 1;
            }
            if (start <= end && start < stat.size) {
              res.writeHead(206, {
                'Content-Type': type,
                'Content-Length': end - start + 1,
                'Content-Range': `bytes ${start}-${end}/${stat.size}`,
                'Accept-Ranges': 'bytes',
              });
              return fs.createReadStream(item.absolute_path, { start, end }).pipe(res);
            }
          }
        }
        res.writeHead(200, {
          'Content-Type': type,
          'Content-Length': stat.size,
          'Accept-Ranges': 'bytes',
          'Content-Disposition': item.ext === '.pdf' ? 'inline' : `inline; filename*=UTF-8''${encodeURIComponent(path.basename(item.absolute_path))}`,
        });
        return fs.createReadStream(item.absolute_path).pipe(res);
      }
      res.writeHead(404); res.end('Not found');
    } catch (error) {
      console.error(error);
      res.writeHead(500); res.end('Internal error');
    }
  });

  return new Promise((resolve, reject) => {
    server.on('error', reject);
    server.listen(port, '127.0.0.1', () => {
      const serverState = {
        pid: process.pid,
        port,
        origin: SHUFANG_PUBLIC_ORIGIN || `http://127.0.0.1:${port}`,
        internalOrigin: `http://127.0.0.1:${port}`,
        libraryId,
        root,
        startedAt: new Date().toISOString(),
      };
      try {
        fs.mkdirSync(APP_DIR, { recursive: true });
        fs.writeFileSync(SHUFANG_SERVER_STATE_FILE, JSON.stringify(serverState, null, 2), 'utf8');
      } catch {}
      const clearState = () => {
        try {
          const current = JSON.parse(fs.readFileSync(SHUFANG_SERVER_STATE_FILE, 'utf8'));
          if (Number(current?.pid) === process.pid) fs.unlinkSync(SHUFANG_SERVER_STATE_FILE);
        } catch {}
      };
      server.once('close', clearState);
      process.once('exit', clearState);
      resolve(server);
    });
  });
}

function openBrowser(url) {
  const platform = process.platform;
  try {
    if (platform === 'win32') {
      // start 是 cmd 内建命令。
      spawn('cmd', ['/c', 'start', '', url], { detached: true, stdio: 'ignore', windowsHide: true }).unref();
    } else if (platform === 'darwin') {
      spawn('open', [url], { detached: true, stdio: 'ignore' }).unref();
    } else {
      spawn('xdg-open', [url], { detached: true, stdio: 'ignore' }).unref();
    }
  } catch {}
}

